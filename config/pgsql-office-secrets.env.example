# /etc/corporatetraveldc/pgsql-office-secrets.env -- corporatetraveldc-pgsql-office's
# OWN bootstrap credential (office skeletons, 2026-10-20; template, disabled until
# after the feature freeze). Install mode 0600, owned by the service user, never
# committed.
#
# NEVER QUOTE ANY VALUE IN THIS FILE (scripts/check-env-quoting.sh).
#
# A DEDICATED file: never pgsql-secrets.env (production), pgsql-demo-secrets.env
# (demo), dispatch.env or dispatch-secrets.env. POSTGRES_USER in the quadlet is
# office_owner, so this value is office_owner's password. It MUST differ from
# every other instance's password.
#
# Created by `sudo install -m 600 -o corporatetraveldc -g corporatetraveldc` from
# this example, then filled IN PLACE by `scripts/office-skeleton-ctl.py fill`
# (generated, never printed, never on a command line).
POSTGRES_PASSWORD=CHANGE_ME
