// 49-ctdc-net-failover.rules -- 2026-11-17 (operator), guarded 2026-11-18 (operator).
// The uplink failover watchdog runs as the operator's user service on a headless box (no active seat
// session), so NetworkManager's default "auth" for these two actions refused every failover.
// Scope: the operator account, these two actions -- and ONLY while no hold is in force:
//   /run/corporatetraveldc-lockdown-active          lockdown.sh (volatile; gone after a reboot)
//   /var/lib/ctdc-lockdown/lockdown-active          lockdown.sh (persistent; survives a reboot)
//   /var/lib/ctdc-lockdown/uncommanded-reboot-hold  ctdc-boot-guard.sh, after any reboot that was not
//                                                   made through scripts/ctdc-reboot.sh
//   /run/ctdc-boot-guard/verified ABSENT            this boot was not (yet) verified as commanded by the
//                                                   boot guard -- if the guard never ran, the rule holds
// Any hold -> NO. No hold -> YES. Any error evaluating the holds -> NOT_HANDLED, i.e. NetworkManager's
// own default ("auth") applies: it fails closed to the pre-2026-11-17 behaviour, never open to YES.
// /var/lib/ctdc-lockdown is root-only-writable, so the account this rule grants cannot clear a hold.
// Holds are cleared only by restore-network.sh (all) or ctdc-reboot.sh --clear-hold (the reboot hold).
// 2026-11-18: each path is probed with stat, never `[ -e ]`. `[ -e ]` reads ANY failure -- an SELinux
// denial included -- as "absent": polkitd (policykit_t) was denied getattr on the var_run_t markers, so
// `verified` looked absent (NO, failover refused) and a real hold would have looked absent too (YES, fail
// OPEN). Only "No such file or directory" now means absent; any other stat failure is error -> NOT_HANDLED.
// The markers carry ctdc_guard_state_t, which polkitd may stat (selinux/corporatetraveldc-guard-markers.te).
polkit.addRule(function(action, subject) {
    if (subject.user != "corporatetraveldc" ||
        (action.id != "org.freedesktop.NetworkManager.settings.modify.system" &&
         action.id != "org.freedesktop.NetworkManager.network-control")) {
        return polkit.Result.NOT_HANDLED;
    }
    var state;
    try {
        state = polkit.spawn(["/usr/bin/sh", "-c",
            "LC_ALL=C; export LC_ALL; " +
            "probe() { if o=$(stat -c %i -- \"$1\" 2>&1); then echo present; else " +
            "case \"$o\" in *'No such file or directory'*) echo absent ;; *) echo error ;; esac; fi; }; " +
            "case $(probe /run/ctdc-boot-guard/verified) in " +
            "absent) echo hold:boot-unverified; exit 0 ;; present) ;; *) echo error:verified; exit 0 ;; esac; " +
            "for f in /run/corporatetraveldc-lockdown-active " +
            "/var/lib/ctdc-lockdown/lockdown-active " +
            "/var/lib/ctdc-lockdown/uncommanded-reboot-hold; do " +
            "case $(probe \"$f\") in present) echo \"hold:${f##*/}\"; exit 0 ;; absent) ;; " +
            "*) echo \"error:${f##*/}\"; exit 0 ;; esac; done; echo clear"]).trim();
    } catch (e) {
        polkit.log("ctdc-net-failover: NOT_HANDLED " + action.id + " (hold check failed)");
        return polkit.Result.NOT_HANDLED;
    }
    if (state == "clear") {
        polkit.log("ctdc-net-failover: YES " + action.id + " (no hold)");
        return polkit.Result.YES;
    }
    if (state.indexOf("hold:") == 0) {
        polkit.log("ctdc-net-failover: NO " + action.id + " (" + state + ")");
        return polkit.Result.NO;
    }
    if (state.indexOf("error:") == 0) {
        polkit.log("ctdc-net-failover: NOT_HANDLED " + action.id + " (cannot read marker " + state.substring(6) + ")");
        return polkit.Result.NOT_HANDLED;
    }
    polkit.log("ctdc-net-failover: NOT_HANDLED " + action.id + " (unexpected hold check output)");
    return polkit.Result.NOT_HANDLED;
});
