# /etc/ctdc-dnsleak/dnsleak.conf -- DNS leak watch and its collector (docs/DNS_LEAK_WATCH.md). key=value, parsed,
# never sourced. Write it with `sudo config/dns-leak-watch/apply.sh init-conf --clients ... --iface ...`.

# The watched device's addresses AS THIS HOST SEES THEM, comma-separated, IPv4 and IPv6, single addresses or CIDRs.
#   Setup A (Tailscale exit node): the phone's two Tailscale addresses (`tailscale status --json`, TailscaleIPs).
#   Setup B (this host is the gateway): the phone's LAN address(es); a DHCP reservation keeps them stable.
# All listed addresses are treated as ONE device (its lookups and its connections are matched together).
CLIENTS=192.0.2.10,2001:db8::10

# TAILNET=yes watches EVERY tailnet device: CLIENTS then includes Tailscale's two ranges (100.64.0.0/10 and
# fd7a:115c:a1e0::/48), and each device is told apart by host name from `tailscale status --json`, read by the root
# run (addresses stay in the root-only root-state.json; reports use host names). This turns on the per-device
# CONNECTION CHECK below.
TAILNET=no

# Connection check: each device gets an evaluation window this long when it comes online or starts sending traffic
# through this host; verdicts PASS / FAIL / NOT-ROUTED (docs/DNS_LEAK_WATCH.md).
CHECK_WINDOW_MIN=10

# Enforcement, OFF by default (no | alert-then-quarantine): a device still FAILing QUARANTINE_GRACE_MIN minutes after
# its first FAIL has its forwarded traffic dropped (DNS to this host and Tailscale itself keep working) until its next
# PASS or `apply.sh release HOST|--all`. Never this host, PROXY_CLIENTS, or a host listed in QUARANTINE_EXEMPT.
QUARANTINE=no
QUARANTINE_GRACE_MIN=5
QUARANTINE_EXEMPT=

# OFF-TUNNEL rule (empty = off): for these host names (or * = every peer; never this host or PROXY_CLIENTS), a device
# that was routed through this box in the last ROUTED_RECENT_MIN minutes and then goes tailnet-offline, or stays online
# without traffic through this box, triggers ONE priority-5 push per episode after OFF_TUNNEL_ALERT_MIN minutes, to
# every topic in NTFY_P5_TOPICS (empty = NTFY_TOPIC). When it comes back it is held (the quarantine sets) until a
# signed release (RELEASE_APPROVAL_CMD, below), or until it passes the connection check CAPTIVE_MIN_HOLD_MIN minutes
# after its return, or `apply.sh release HOST`. QUARANTINE_EXEMPT hosts get the push but are never held.
ALWAYS_ON_HOSTS=
ROUTED_RECENT_MIN=30
OFF_TUNNEL_ALERT_MIN=5
NTFY_P5_TOPICS=
CAPTIVE_MIN_HOLD_MIN=10
# After a release (signed or apply.sh release) the device is not held again for this many minutes: not on its
# return from an off-tunnel episode, not by a FAIL quarantine (2026-11-28: a phone released while off the tailnet
# was held again the moment it came back). 0 = no grace.
RELEASE_GRACE_MIN=30
# Every push, report and screen names a device only as dev-<10 hex>: an HMAC of its host name under this key (made
# once by the root run, 0640 root:READ_GROUP). The real names stay in root-only state; the signed release carries the
# real name, the device's Tailscale machine key and the tag. apply.sh release takes a name or a tag.
TAG_KEY_FILE=/var/lib/ctdc-dnsleak/hold-tag.key

# Optional signed release: a program (absolute path, no arguments) run as RELEASE_APPROVAL_USER (never root) with
# `check --host HOST --since EPOCH`; it must verify a human signature itself and print exactly "ok <id>" when a
# release is signed. Empty = no signed release (auto and manual release still work).
RELEASE_APPROVAL_CMD=
RELEASE_APPROVAL_USER=

# On-device check, OFF by default: for Linux peers, run the vendored dns-lockdown-check.sh over Tailscale SSH as this
# non-root user (60 s limit; only its PASS/FAIL lines are kept). Needs a Tailscale SSH ACL rule (see the docs).
DEVICE_SSH_CHECK=no
DEVICE_SSH_USER=

# Addresses whose Pi-hole lookups count as the watched device's own (default empty). Needed when the device's DNS
# reaches Pi-hole THROUGH this host -- e.g. a Tailscale exit node forwarding the phone's DNS, so Pi-hole logs this
# host's loopback or tailnet address as the client. Run `apply.sh diagnose` to see which case you have. Limit: this
# host's own lookups then count as the device's too, which can hide a hard-coded address this host also resolved.
PROXY_CLIENTS=

# The interface the device's traffic arrives on: tailscale0 (setup A) or the LAN interface (setup B).
IFACE=tailscale0

# Pi-hole's query log (dnsmasq style). Yesterday's rotation is expected at the same path + ".1".
PIHOLE_LOG=/var/log/pihole/pihole.log

# Reports and state (0750 dir, 0640 files, owner root, group READ_GROUP so one non-root account can read them).
OUT_DIR=/var/lib/ctdc-dnsleak
READ_GROUP=root

# How long a destination stays in the kernel set after its last new connection, and the lookback window: an address
# no Pi-hole answer handed out to anyone within INDEX_HOURS is "hardcoded".
SET_TIMEOUT=6h
INDEX_HOURS=48

# Reverse-DNS hint for hard-coded and bypass destinations, through the local resolver (yes / no).
RDNS=yes

# Encrypted resolvers (DoH / DoT / DoQ), refreshed once a day by ctdc-dnsleak-resolvers.timer (never by the watch):
#   KNOWN    RESOLVER_LIST_URL plus RESOLVER_EXTRA_URLS (space-separated address lists; each keeps a last good copy).
#            Fewer than RESOLVER_MIN merged entries is refused and the last good list kept.
#   LEARNED  public: addresses Pi-hole handed out for a resolver host name on RESOLVER_DOMAINS_URL;
#            hard-coded: addresses the watch saw apps send DNS to directly (port 53 before the dns-lock redirect, 853,
#            8853). Kept LEARNED_DAYS after last seen, in OUT_DIR/learned-resolvers.json.
# The refresh is skipped while the default route uses an interface in METERED_IFACES (empty = never skip).
RESOLVER_LIST=/etc/ctdc-dnsleak/encrypted-resolvers.txt
RESOLVER_LIST_URL=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/ips/doh.txt
RESOLVER_EXTRA_URLS=https://raw.githubusercontent.com/dibdot/DoH-IP-blocklists/master/doh-ipv4.txt https://raw.githubusercontent.com/dibdot/DoH-IP-blocklists/master/doh-ipv6.txt
RESOLVER_DOMAINS_URL=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard/doh-onlydomains.txt
RESOLVER_MIN=100
LEARNED_DAYS=90
METERED_IFACES=

# Forward defense (yes / no). yes: forwarded DoT (853/tcp), DoQ (853, 8853/udp), plain DNS that was not redirected
# to this host, and 443 to a blockable known or learned resolver are REJECTED (so the app falls back to normal DNS,
# which Pi-hole answers), after the watch records the attempt. Never blocked: LAN, tailnet and Tailscale relay
# addresses, and any address Pi-hole also answered for ordinary names (shared hosting). A blocked attempt does not
# fail a device's connection check; it is counted in it. no: detection only.
BLOCK=no

# Known infrastructure: Tailscale's relay (DERP) servers are reached by address by design, so they are listed as
# context, never as hard-coded findings, and never blocked. The community list by JM Addington
# (https://github.com/jmaddington/tailscale-ips) is fetched daily and cross-checked against Tailscale's own DERP
# map: only addresses both carry are kept. INFRA_SEED: a local copy used on a first run when the official map is
# unreachable (for example the bundler repo's pinned submodule, tailscale-ips/tailscale.all.txt). Empty = none.
INFRA_LIST=/etc/ctdc-dnsleak/known-infra.txt
INFRA_URL=https://raw.githubusercontent.com/jmaddington/tailscale-ips/main/tailscale.all.txt
INFRA_CHECK_URL=https://controlplane.tailscale.com/derpmap/default
INFRA_SEED=

# ECH (Encrypted Client Hello): not a resolver, but it hides the site name inside TLS. The daily refresh asks this
# host's resolver for the HTTPS record of up to ECH_PROBE_MAX recently looked-up names and lists those that carry an
# ECH config, plus ECH_NAMES (known ECH front names). Context only: Pi-hole still filtered those lookups.
ECH_NAMES=cloudflare-ech.com
ECH_PROBE_MAX=300

# Optional: a counter of plain DNS queries another table redirects to Pi-hole ("family table counter"); read as a
# per-run delta and exported with the bypass evidence. Absent table = skipped. Empty = off.
DNSLOCK_COUNTER=inet ctdc_dnslock dns_tailnet_redirect

# Optional push (ntfy): one message per run with new hard-coded destinations, one daily digest. Empty = none.
# The token file holds a PUBLISH-ONLY token, root 0600.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN_FILE=
