# /etc/corporatetraveldc/firefly-secrets.env -- corporatetraveldc-firefly (Firefly III,
# the CFO skeleton ledger; office skeletons, 2026-10-20; template, disabled until
# after the feature freeze). Install mode 0600, owned by the service user, never
# committed.
#
# NEVER QUOTE ANY VALUE IN THIS FILE (scripts/check-env-quoting.sh).
#
# Secrets only. The database engine and every other non-secret setting are
# Environment= lines in the tracked quadlet (DB_CONNECTION=pgsql) and must never
# be set here (tests/scripts/test_office_skeletons.py).
#   APP_KEY            exactly 32 characters (Laravel encryption key)
#   DB_PASSWORD        the `firefly` role's password on corporatetraveldc-pgsql-office
#   STATIC_CRON_TOKEN  exactly 32 characters (the recurring-transactions cron call)
# Filled IN PLACE by `scripts/office-skeleton-ctl.py fill` (generated, never printed).
APP_KEY=CHANGE_ME
DB_PASSWORD=CHANGE_ME
STATIC_CRON_TOKEN=CHANGE_ME
