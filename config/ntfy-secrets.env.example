# /etc/corporatetraveldc/ntfy-secrets.env
#
# Scoped secrets for the ntfy container ONLY -- never the full
# dispatch-secrets.env. 2026-08-26 (Opus blind review C-4): ntfy is
# third-party code with no CTDI-specific hardening; it used to load all
# ~95 keys in dispatch-secrets.env (including the FAA SWIM/NWWS passwords,
# the Cloudflare account-management token, the Tailscale API key, and the
# signing-key passphrase) even though it only ever reads its own five
# SMTP/Twilio config values. Any RCE in the ntfy image no longer yields
# the whole credential set.
#
# NTFY_TOKEN is deliberately NOT here -- that is CTDI's own client-side
# auth token for PUSHING to ntfy, not something the ntfy server itself
# needs to read from its own environment.
#
# File must be mode 0600, owned by the user the ntfy container runs as.

NTFY_SMTP_SENDER_PASS=CHANGE_ME
NTFY_TWILIO_ACCOUNT=CHANGE_ME
NTFY_TWILIO_AUTH_TOKEN=CHANGE_ME
NTFY_TWILIO_PHONE_NUMBER=CHANGE_ME
NTFY_TWILIO_VERIFY_SERVICE=CHANGE_ME
