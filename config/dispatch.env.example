# -- Thermal ingest guard (scripts/thermal-ingest-guard.py) ------------------
# Automatic fallback for SWIM ingest containers when the box runs hot.
# (The Ollama governor it once ran alongside was retired with Ollama on
# 2026-08-27; the temperatures below were tuned against it.) Added 2026-07-26 after an Argon ONE case reseat ran
# hotter than the prior 40+ hours even with the fan confirmed pinned at
# its rated max RPM -- manually stopping the five heaviest SWIM containers
# (tfms/stdds/fdps/tbfm/itws, ~68% combined CPU) was the most effective
# lever available remotely. This makes that a permanent, tunable, automatic
# safety net. Runs every 2 min via corporatetraveldc-thermal-ingest-guard.timer
# (systemd --user, no root). Tier 1 is the proactive trip; tier 2 is the
# harder fallback if tier 1 alone doesn't cool things down. Resume requires
# holding below the resume temperature for the full dwell window, so a brief
# dip doesn't flap the feeds back on.
# SUPERSEDED 2026-10-06: Automatic fallback for SWIM ingest containers when the box runs hot,
# SUPERSEDED 2026-10-06: independent of ollama_governor.py (never touches Ollama's own thermal
# SUPERSEDED 2026-10-06: SIGSTOP/SIGCONT). Added 2026-07-26 after an Argon ONE case reseat ran
# SUPERSEDED 2026-10-06: (systemd --user, no root). Tier 1 trips BELOW Ollama governor's own 75-76C
# SUPERSEDED 2026-10-06: pause point (proactive -- try to avoid the Ollama pause happening at all);
# SUPERSEDED 2026-10-06: tier 2 is the harder fallback if tier 1 alone doesn't cool things down.
# SUPERSEDED 2026-10-06: Resume threshold sits below Ollama's own 67.75C resume point and requires
# SUPERSEDED 2026-10-06: holding for the full dwell window before restoring, so a brief dip doesn't
# SUPERSEDED 2026-10-06: flap the feeds back on right as Ollama itself is about to add load back.
THERMAL_GUARD_ENABLED=true
THERMAL_GUARD_TIER1_TEMP_C=74.0
THERMAL_GUARD_TIER2_TEMP_C=79.0
THERMAL_GUARD_RESUME_TEMP_C=65.0
THERMAL_GUARD_RESUME_DWELL_S=300
THERMAL_GUARD_TIER1_FEEDS=tfms,stdds
THERMAL_GUARD_TIER2_FEEDS=fdps,tbfm,itws


# Compliance egress (outbound audit push) -- added 2026-08-03. Ships
# disabled. See src/common/compliance_egress.py for the full contract.
# COMPLIANCE_TARGET_URL and (optional) COMPLIANCE_TARGET_AUTH_HEADER go in
# dispatch-secrets.env, not here -- they can reveal or grant access to an
# internal endpoint.
COMPLIANCE_HOOK_ENABLED=false
COMPLIANCE_RETRY_LIMIT=5


# ── Maintenance window (overnight window) ─────────────────────────────────────
# The ONLY hours in which long report-tier jobs are permitted to run. Enforced
# by scripts/maintenance-window-guard.sh, wired as ExecCondition= on the
# governed units (second-brain compiles, weekly summaries, the long daily
# watch family). Outside these hours those units skip cleanly -- they are NOT
# marked failed, so no OnFailure= page fires.
#
# Why: long jobs contend for the same two cores as the latency-sensitive
# flight/weather alert path. Missing one overnight alert cycle costs far less
# than clobbering a brief the operator is waiting on.
#
# Window may wrap midnight (the default does). Start is inclusive, end is
# exclusive: with 23:00-05:00, a job at exactly 23:00 runs, one at 05:00 does
# not.
#
# *** WARNING ***
# Adding the guard to a unit whose OnCalendar= falls OUTSIDE this window
# disables that unit permanently and silently -- it skips forever, with no
# failure and no alert. Units firing multiple times a day (e.g.
# `00,06,12,18:02:00`) must never be guarded; the guard would kill every slot
# but the overnight one. Check any unit before wiring it:
#     scripts/maintenance-window-guard.sh --check --at 04:30
CTDC_MAINTENANCE_WINDOW_START=23:00
CTDC_MAINTENANCE_WINDOW_END=05:00
CTDC_MAINTENANCE_WINDOW_TZ=America/New_York

# Operational day (2026-10-04, src/common/optime.py). Containers run in UTC on
# purpose and storage is UTC epoch; anything DAY-KEYED (vault day files, digest
# windows, headings) follows this local zone, and local times before the
# rollover belong to the previous operational day. Unset = these defaults.
DISPATCH_LOCAL_TZ=America/New_York
DISPATCH_DAY_ROLLOVER=05:00

# 2026-10-05: the operator's home air traffic control zone(s) (ARTCC/FIR codes).
# 14 CFR 91.137 / 91.145 TFRs: home 5, monitor 4, anywhere else 3;
# 91.141, 91.143, 99.7 and 49 USC 40103(b) TFRs are priority 5 everywhere.
# Set to your own ARTCC code(s), comma-separated (e.g. ZLA). Empty = no home zone.
NOTAM_HOME_ARTCCS=
# monitor zones: other centers whose hubs matter to you (e.g. ZNY,ZTL). Empty = none.
NOTAM_MONITOR_ARTCCS=

# airplanes.live fallback-only lookup after local ADS-B/FDPS/registry are dark.
# Off by default; set 1 only if you feed airplanes.live and are permitted to query its API.
AIRPLANES_LIVE_FALLBACK=0
