# ââ Web API âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
DISPATCH_WEB_HOST=0.0.0.0
DISPATCH_WEB_PORT=8000

# ── Amtrak / Rail ─────────────────────────────────────────────────────────────
# Configure the train map and schedule panel for your operator's hub city.
# All three vars are optional — defaults are Washington DC / NEC corridor.
#
# AMTRAK_FEED_URL              : Amtraker v3 API endpoint. Default is correct.
#                               Leave unset unless self-hosting Amtraker locally.
AMTRAK_FEED_URL=https://api.amtraker.com/v3/trains
AMTRAKER_API_URL=https://api.amtraker.com/v3

# AMTRAK_PRIMARY_STATION        : Your hub station. Map centering + fallback filter.
#                                 One station code. https://www.amtrak.com/stations
#                           DC example  : WAS
#                           Chicago     : CHI   New York: NYP
#                           See full list: https://www.amtrak.com/stations
AMTRAK_PRIMARY_STATION=WAS
#
# AMTRAK_REGIONAL_STATIONS: Comma-separated station codes that gate long-distance
#                           trains. A non-NEC train is shown only if its route
#                           calls at one of these. Leave blank for DC defaults.
#                           DC default  : WAS,BWI,NCR,ALX,BAL,ABE,WIL,NPN
#                           Chicago ex  : CHI,MKE,GBD,NPV,ELB,GLV
AMTRAK_REGIONAL_STATIONS=
#
# AMTRAK_CORE_ROUTES      : Routes that always appear in the top panel section
#                           regardless of live GPS status. Leave blank for DC.
#                           DC default  : Acela,Northeast Regional
#                           Chicago ex  : Empire Builder,California Zephyr
AMTRAK_CORE_ROUTES=

# -- Local LLM (llama.cpp) ----------------------------------------------------
# One local model server: llama.cpp's OpenAI-compatible API
# (corporatetraveldc-llama user unit, src/common/llm.py + llama_pool.py).
# Ollama was retired on 2026-08-27; nothing listens on :11434 any more.
#
# Priority (src/common/llm.py):
#   1. llama.cpp at LLAMA_BASE_URL, if reachable.
#   2. Anthropic -- only when ANTHROPIC_FALLBACK_ENABLED is not "false" AND the
#                  call site passes allow_anthropic AND ANTHROPIC_API_KEY is set.
#   3. Deterministic -- each skill's own rule-based fallback.
# Set ANTHROPIC_FALLBACK_ENABLED=false for a fully local-only deployment.
#ANTHROPIC_FALLBACK_ENABLED=true
#
# LLAMA_BASE_URL is the name; OLLAMA_BASE_URL is a deprecated alias the code
# still reads as a fallback (remove once every image is rebuilt).
LLAMA_BASE_URL=http://100.x.x.x:8093
# Persona labels passed to the server (legacy OLLAMA_* names, kept for
# compatibility; llama.cpp serves one model and applies the persona prompt).
OLLAMA_CHAT_MODEL=CHANGE_TO_YOUR_MODEL
OLLAMA_OSINT_MODEL=CHANGE_TO_YOUR_MODEL

