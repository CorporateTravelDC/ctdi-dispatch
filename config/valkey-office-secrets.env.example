# /etc/corporatetraveldc/valkey-office-secrets.env -- corporatetraveldc-valkey-office
# (the Paperless-ngx broker; office skeletons, 2026-10-20; template, disabled until
# after the feature freeze). Install mode 0600, owned by the service user, never
# committed.
#
# NEVER QUOTE ANY VALUE IN THIS FILE (scripts/check-env-quoting.sh).
#
# The broker password. paperless-secrets.env carries the same value inside
# PAPERLESS_REDIS; `scripts/office-skeleton-ctl.py fill` generates it here and
# derives that URL from it (never printed, never on a command line).
VALKEY_PASSWORD=CHANGE_ME
