# /etc/corporatetraveldc/paperless-secrets.env -- corporatetraveldc-paperless
# (Paperless-ngx, EA + CFO skeleton documents; office skeletons, 2026-10-20;
# template, disabled until after the feature freeze). Install mode 0600, owned by
# the service user, never committed.
#
# NEVER QUOTE ANY VALUE IN THIS FILE (scripts/check-env-quoting.sh).
#
# Secrets only. PAPERLESS_DBENGINE=postgresql and every other non-secret setting
# are Environment= lines in the tracked quadlet and must never be set here
# (tests/scripts/test_office_skeletons.py).
#   PAPERLESS_SECRET_KEY  Django secret key
#   PAPERLESS_DBPASS      the `paperless` role's password on corporatetraveldc-pgsql-office
#   PAPERLESS_REDIS       broker URL with the Valkey password (derived from
#                         valkey-office-secrets.env by the fill step)
# Filled IN PLACE by `scripts/office-skeleton-ctl.py fill` (generated, never printed).
PAPERLESS_SECRET_KEY=CHANGE_ME
PAPERLESS_DBPASS=CHANGE_ME
PAPERLESS_REDIS=CHANGE_ME
