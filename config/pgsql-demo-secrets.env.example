# /etc/corporatetraveldc/pgsql-demo-secrets.env -- corporatetraveldc-pgsql-demo's
# OWN bootstrap credential (install mode 0600, owned by the service user,
# never committed). 2026-10-16, demo/production database split.
#
# NEVER QUOTE ANY VALUE IN THIS FILE (scripts/check-env-quoting.sh).
#
# This is a DEDICATED file: never pgsql-secrets.env (the production
# instance's password), never dispatch-secrets.env. POSTGRES_USER in the
# quadlet is demo_owner, so this value is demo_owner's password: the
# host-side scrub (scripts/scrub-demo-source.py) and
# scripts/pg_migrate.py --instance demo read it from HERE (as
# DEMO_PG_PASSWORD when that is unset) and nothing else does. It MUST
# differ from the production POSTGRES_PASSWORD. Generate once:
#   openssl rand -hex 24
# Type it in through `read -rs ... </dev/tty` into the file; it never goes
# on a command line or into a relay.
POSTGRES_PASSWORD=CHANGE_ME
