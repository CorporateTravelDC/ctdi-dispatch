# /etc/corporatetraveldc/demo.env -- NON-SECRET environment for the two
# public-demo containers (corporatetraveldc-demo-api, corporatetraveldc-
# runner-demo). 2026-10-16, demo/production database split. Installed and
# wired in RELAY 2 (the quadlets switch from dispatch.env to this file);
# relay 1 only tracks the example. Secrets go in demo-secrets.env.
#
# NEVER QUOTE ANY VALUE IN THIS FILE (podman --env-file keeps the quotes;
# scripts/check-env-quoting.sh). No DISPATCH_PG_* key may ever appear here:
# those name the PRODUCTION instance, and common.db_backend refuses them
# from a demo-role process anyway.

# The role switch. common.db.conn() routes to the DEMO instance's pool
# (db_backend.demo_pg_conn) and db_backend.pg_conn() refuses outright.
DISPATCH_ROLE=demo
DISPATCH_DB_BACKEND=postgres
# Belt and braces: refuses the production database/role by name too.
DISPATCH_DEMO_ISOLATION=1

# The demo Postgres instance (corporatetraveldc-pgsql-demo), over the socket
# volume corporatetraveldc-pgsql-demo-sock mounted at this path in the demo
# containers. Port 5432 is the instance's own port (the socket file name);
# the host publish 127.0.0.1:5433 is for the host-side scrub only.
DEMO_PG_HOST=/var/run/postgresql-demo
DEMO_PG_PORT=5432
DEMO_PG_DB=corporatetraveldc_demo
DEMO_PG_USER=demo
# DEMO_PG_PASSWORD lives in demo-secrets.env, never here.

# demo-api reads snapshots/brief_archive/meta from the demo instance instead
# of the sovereign SQLite file (src/demo/demo_api.py source_kind()).
DEMO_SOURCE=postgres

# Playback / runner settings the demo containers used to inherit from
# dispatch.env -- copy the values the public demo needs here, non-secret
# only (DEMO_LOOP_DAYS, DEMO_ANCHOR_OVERRIDE, LLAMA_BASE_URL, NTFY_URL ...).
DEMO_LOOP_DAYS=14
