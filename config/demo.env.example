# /etc/corporatetraveldc/demo.env -- the WHOLE non-production environment of the
# two public-demo containers (corporatetraveldc-demo-api, corporatetraveldc-
# runner-demo). 2026-10-16, demo/production database split; installed and
# wired in RELAY 2 (2026-10-19): the quadlets dropped dispatch.env and load
# demo-secrets.env, then THIS file LAST (later --env-file wins, so the
# DISPATCH_DB_BACKEND below overrides demo-secrets.env's old sqlite pin).
#
# Mode 0600, owned by the service user: since relay 2 it carries the `demo`
# role's password (DEMO_PG_PASSWORD -- the demo instance's application role
# only; never a production value). Created ONCE by the hand step
#   sudo install -m 600 -o corporatetraveldc -g corporatetraveldc \
#       config/demo.env.example /etc/corporatetraveldc/demo.env
# (/etc/corporatetraveldc is root:corporatetraveldc 0750 -- the service user
# cannot create files there); from then on scripts/demo-env.py edits it in
# place: `seed`, `set-password`, `source sqlite|postgres`, `check`.
#
# NEVER QUOTE ANY VALUE IN THIS FILE (podman --env-file keeps the quotes;
# scripts/check-env-quoting.sh). No DISPATCH_PG_* key may ever appear here:
# those name the PRODUCTION instance (scripts/demo-env.py check refuses them,
# and common.db_backend refuses them from a demo-role process anyway).

# The role. Also an Environment= line in both quadlets (identity is signed);
# repeated here so the file is self-describing.
DISPATCH_ROLE=demo
# Belt and braces: refuses the production database/role by name too.
DISPATCH_DEMO_ISOLATION=1

# THE ROLLBACK SWITCH -- always set as a pair, by `scripts/demo-env.py source
# sqlite|postgres` (then restart the two demo containers):
#   postgres  playback from the demo instance, profiles in its demo_profiles,
#             runner-demo chat in its chat_messages (relay 2 onward)
#   sqlite    playback from the sovereign file (/var/lib/corporatetraveldc-
#             demo-source, still mounted read-only), profiles from
#             demo_access.db, chat in the demo-only mount (the pre-flip state)
# Not Environment= lines in the quadlets on purpose: podman's -e beats
# --env-file, and a rollback must not need a signed quadlet edit.
DEMO_SOURCE=postgres
DISPATCH_DB_BACKEND=postgres

# The demo Postgres instance (corporatetraveldc-pgsql-demo), over the socket
# volume corporatetraveldc-pgsql-demo-sock mounted at this path in the demo
# containers. Port 5432 is the instance's own port (the socket file name);
# the host publish 127.0.0.1:5433 is for the host-side scrub only.
DEMO_PG_HOST=/var/run/postgresql-demo
DEMO_PG_PORT=5432
DEMO_PG_DB=corporatetraveldc_demo
DEMO_PG_USER=demo
# Set by `scripts/demo-env.py set-password` (typed through read -rs, or
# generated), never by hand-editing in a relay, never printed.
DEMO_PG_PASSWORD=CHANGE_ME

# Settings runner-demo used to inherit from dispatch.env, NON-SECRET only,
# copied BY NAME by `scripts/demo-env.py seed` (nothing else from dispatch.env
# is ever copied: ULTRAFEEDER_URL / ACARSHUB_URL in particular stay out, the
# demo runner must never reach local ADS-B / ACARS data).
LLAMA_BASE_URL=CHANGE_ME
OLLAMA_CHAT_MODEL=CHANGE_ME

# Playback.
DEMO_LOOP_DAYS=14
