# /etc/corporatetraveldc/demo-secrets.env
#
# Scoped secrets for a public-facing demo instance -- runner-demo +
# demo-api ONLY load this file, never the full dispatch-secrets.env.
# 2026-08-26 (Opus blind review C-22 follow-up): both containers used to
# load nothing at all here, so DEMO_SESSION_SECRET fell back independently
# to a random per-process value in each -- a session token issued by
# demo-api could never actually verify against runner-demo's own
# unrelated fallback secret, silently breaking the password gate.
#
# Convention for future public-facing demo variants (a marketing-specific
# build, an EA-role demo, a travel-agent-role demo, an internal-only
# longitudinal-archive demo that should NEVER be exposed publicly, etc.):
# each gets its OWN dedicated <role>-demo-secrets.env, containing only
# that instance's own data, wired into that instance's own quadlet pair
# via EnvironmentFile=. Swapping which file a given deployment loads is
# how you swap which demo variant it represents and what it's gated
# with -- without touching any code. An operator standing up their own
# public fork of this platform does the same: generate their own value
# below, never reuse anyone else's.
#
# Generate a real value:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# File must be mode 0600, owned by the user the demo containers run as.

DEMO_SESSION_SECRET=CHANGE_ME

# ~~DISPATCH_DB_BACKEND=sqlite~~ -- removed 2026-10-20. It was a demo-scoped
# override (live since 2026-09-28) pinning the public demo to sqlite; relay 2
# (2026-10-19) made demo.env's postgres win, and the sqlite rollback is now
# retired (operator decision 2026-10-19: only Pi-hole, vnstat and ACARS Hub
# touch SQLite; DISPATCH_DB_BACKEND=sqlite raises SqliteRetired). The quadlets
# set DISPATCH_DB_BACKEND=postgres as a signed Environment= line, so a
# leftover line in the live file cannot win; deleting it there is an
# operator hand step (no value involved). Nothing but secrets belongs here.

# ~~DEMO_PG_PASSWORD=CHANGE_ME~~ (2026-10-16 relay 1 put the `demo` role's
# password here; 2026-10-19 relay 2 moved it to /etc/corporatetraveldc/demo.env,
# 0600, set by `scripts/demo-env.py set-password` -- one file holds the whole
# demo identity ~~and the rollback switch~~). NEVER DISPATCH_PG_PASSWORD in this
# file: that is the production credential, and the two demo containers must
# never hold it (tests/scripts/test_demo_isolation.py).
