# /etc/corporatetraveldc/ultrafeeder-secrets.env
#
# Scoped secrets for the UltraFeeder ADS-B container ONLY -- never the
# full dispatch-secrets.env. 2026-08-26 (Opus blind review C-4): this is
# third-party SDR-feeder code parsing untrusted RF/network input; it used
# to load all ~95 keys in dispatch-secrets.env for six values. Note that
# READSB_LAT/READSB_LON are the same physical-location value the app
# treats as its most protected secret (see C-2) -- scoping this container
# does not by itself fix that exposure, it only limits the blast radius
# of an RCE inside this specific third-party image.
#
# File must be mode 0600, owned by the user the container runs as.

READSB_LAT=CHANGE_ME
READSB_LON=CHANGE_ME
READSB_ALT=CHANGE_ME
TAR1090_DEFAULTCENTERLAT=CHANGE_ME
TAR1090_DEFAULTCENTERLON=CHANGE_ME
UUID=CHANGE_ME
