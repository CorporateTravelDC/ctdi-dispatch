# /etc/corporatetraveldc/ollama-governor.env
#
# Runtime config for ollama-governor.service (scripts/ollama_governor.sh /
# /usr/local/bin/ollama_governor.py) -- the root-level thermal safety net
# that SIGSTOPs the native `ollama serve` process when CPU temp crosses
# MAX_TEMP and SIGCONTs it once it drops back to/below RECOVER_TEMP.
#
# Loaded via EnvironmentFile=-/etc/corporatetraveldc/ollama-governor.env
# in the systemd unit (the "-" prefix makes the file optional -- if it
# doesn't exist, or a line here is missing, the script's own os.getenv()
# defaults below apply, which match this box's original hardcoded
# values exactly). To change a threshold: edit this file, then
# `sudo systemctl restart ollama-governor.service` -- no reinstall, no
# rerunning scripts/ollama_governor.sh, no SELinux policy work needed.
#
# This box (Pi 5, well-cased, good airflow post-2026-08-05 case
# migration) runs comfortably at the defaults. A deployment on lesser
# hardware -- an older Pi, a passively-cooled board, anything with a
# lower safe thermal ceiling -- should lower MAX_TEMP/RECOVER_TEMP
# accordingly. RECOVER_TEMP must stay below MAX_TEMP (the script
# refuses to start otherwise -- the pause/resume state machine can't
# settle if it isn't).

# Freeze Ollama at/above this CPU temp, degrees C.
OLLAMA_GOVERNOR_MAX_TEMP_C=75.0

# Resume Ollama once CPU temp drops to/below this, degrees C.
OLLAMA_GOVERNOR_RECOVER_TEMP_C=68.0

# How often the governor polls the thermal sensor, seconds.
OLLAMA_GOVERNOR_CHECK_INTERVAL_S=2.0
