# /etc/corporatetraveldc/vikunja-secrets.env -- corporatetraveldc-vikunja (Vikunja,
# the optional CoS skeleton initiative API; office skeletons, 2026-10-20; template,
# disabled until after the feature freeze). Install mode 0600, owned by the service
# user, never committed.
#
# NEVER QUOTE ANY VALUE IN THIS FILE (scripts/check-env-quoting.sh).
#
# Secrets only. VIKUNJA_DATABASE_TYPE=postgres and every other non-secret setting
# are Environment= lines in the tracked quadlet and must never be set here
# (tests/scripts/test_office_skeletons.py).
#   VIKUNJA_DATABASE_PASSWORD  the `vikunja` role's password on corporatetraveldc-pgsql-office
#   VIKUNJA_SERVICE_SECRET     JWT signing secret (Vikunja's service.secret)
# Filled IN PLACE by `scripts/office-skeleton-ctl.py fill` (generated, never printed).
VIKUNJA_DATABASE_PASSWORD=CHANGE_ME
VIKUNJA_SERVICE_SECRET=CHANGE_ME
