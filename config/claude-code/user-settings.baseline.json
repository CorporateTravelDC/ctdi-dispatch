{
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /opt/corporatetraveldc/private/ctdi-dispatch-internal/.claude/skills/dispatch-context-guardian/scripts/context_hook.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /opt/corporatetraveldc/private/ctdi-dispatch-internal/.claude/skills/dispatch-context-guardian/scripts/restore_dispatch_state.py 2>/dev/null || true",
            "timeout": 90,
            "statusMessage": "Restoring dispatch state"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "bash /home/corporatetraveldc/.claude/statusline-command.sh"
  },
  "autoCompactWindow": 900000,
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": false
}
