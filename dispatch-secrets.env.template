# =============================================================================
# Cloud LLM API keys
# =============================================================================
# ANTHROPIC_API_KEY — used as the automatic fallback when Ollama is unreachable
# or a model call fails. Skills probe Ollama first; if that fails they call
# claude-haiku via this key. No code changes needed — just uncomment and set.
# If neither Ollama nor this key is configured, skills use deterministic output.
#
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# OpenAI (ChatGPT / GPT-4):
# OPENAI_API_KEY=

# Google Gemini:
# GOOGLE_API_KEY=

# ntfy email notifications (ProtonMail Bridge SMTP password)
# Retrieve with: podman exec systemd-corporatetraveldc-protonbridge /protonmail/vault-editor read | grep BridgePass
NTFY_SMTP_SENDER_PASS=CHANGE_ME

# ntfy phone call notifications (Twilio)
# Requires: Twilio account at https://console.twilio.com
NTFY_TWILIO_ACCOUNT=CHANGE_ME
NTFY_TWILIO_AUTH_TOKEN=CHANGE_ME
NTFY_TWILIO_PHONE_NUMBER=CHANGE_ME
NTFY_TWILIO_VERIFY_SERVICE=CHANGE_ME

# Pushover Emergency co-fire (all priority-5 hot alerts)
# Get token: https://pushover.net/apps/build
# Get user key: https://pushover.net account page
PUSHOVER_TOKEN=CHANGE_ME
PUSHOVER_USER_KEY=CHANGE_ME
PUSHOVER_CALLBACK_NUMBER=CHANGE_ME
PUSHOVER_RETRY_SEC=60
PUSHOVER_EXPIRE_SEC=120

