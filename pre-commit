#!/bin/bash
# pre-commit -- credential pattern scanner
# Rejects any staged content matching known secret patterns.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Patterns checked:
#   sk_adjs_         acarsdrama Jumpseat tokens
#   sk-ant-api       Anthropic API keys
#   github_pat_      GitHub fine-grained PATs
#   ghp_             GitHub classic PATs
#   ghs_             GitHub app tokens
#   Bearer [A-Za-z0-9]{20,}   bare Bearer tokens in source
#   [A-Z_]{4,}=(\S{24,})     env var = long value (catches raw creds in env files)
#   [0-9a-f]{64}     raw 64-char hex (API keys, hashes used as secrets)

set -euo pipefail

# 2026-08-24: a real commit was rejected on a false positive traced to
# this exact cause -- some interactive shell profiles on this box (Claude
# Code CLI's own shell integration is the confirmed instance) install a
# `grep` shell FUNCTION that shadows the real binary and gets inherited
# by this hook's subprocess (bash functions propagate to child processes
# via exported BASH_FUNC_* env vars, unlike aliases). That wrapper mangled
# `grep -E "^+"` (meant to isolate only *added* diff lines) badly enough
# that *removed* lines matched too -- an already-redacted example token
# being deleted from a doc (replaced with a `<placeholder>` form) got
# flagged as if it were being added. `unalias`/`unset -f` below strips any
# shadowing alias or function so this hook always runs against the real
# grep regardless of what's active in the invoking shell.
unalias grep 2>/dev/null || true
unset -f grep 2>/dev/null || true

FAIL=0
# CORRECTED 2026-08-27: sk_adjs_/sk-ant-api/github_pat_ used to be bare
# prefixes with no required characters after them -- unlike ghp_/ghs_
# below, which already require at least one token char to follow. A real
# security-report doc that merely NAMES the credential type ("zero
# GitHub `ghp_`/`github_pat_` tokens found") tripped this every time,
# with no actual leaked value present at all -- confirmed live, the
# match was inside a doc's own scan-summary prose. Now requires a
# minimum run of real token-shaped characters after each prefix, same
# discipline ghp_/ghs_ already had; a bare mention of the prefix alone
# no longer matches, a real token still does.
PATTERNS=(
    "sk_adjs_[A-Za-z0-9_\-]{10,}"
    "sk-ant-api[A-Za-z0-9_\-]{10,}"
    "github_pat_[A-Za-z0-9_]{20,}"
    "ghp_[A-Za-z0-9]"
    "ghs_[A-Za-z0-9]"
    "Bearer [A-Za-z0-9_\-\.]{20,}"
)

# Get staged diff (new/modified content only, no deletions)
STAGED=$(git diff --cached --diff-filter=ACM --unified=0 2>/dev/null) || true
[ -z "$STAGED" ] && exit 0

for pattern in "${PATTERNS[@]}"; do
    # CORRECTED 2026-08-26 (Opus blind review H-6, same class of bug fixed
    # in scripts/pre-push same day): the exemptions below used to be
    # `grep -v` over the WHOLE matched line -- a genuine leaked token
    # survives untouched as long as ANY exempted word appears ANYWHERE
    # else on that same line (e.g. a real token followed by a trailing
    # "# example" comment). Now scoped to a ~20-char window immediately
    # around the actual match, not the whole line.
    candidates=$(echo "$STAGED" | grep -E "^\+" 2>/dev/null | grep -v "^+++" 2>/dev/null | \
                 grep -E "$pattern" || true)
    matches=""
    if [ -n "$candidates" ]; then
        while IFS= read -r cand_line; do
            [ -z "$cand_line" ] && continue
            window=$(echo "$cand_line" | grep -oE ".{0,20}(${pattern}).{0,20}" | head -1)
            [ -z "$window" ] && window="$cand_line"
            if ! echo "$window" | grep -qE "CHANGE_ME|YOUR_|example|placeholder|REDACTED|<[^>]*>|\.\.\."; then
                if ! echo "$window" | grep -qi "deadbeef"; then
                    matches="${matches}${cand_line}"$'\n'
                fi
            fi
        done <<< "$candidates"
    fi
    if [ -n "$matches" ]; then
        echo ""
        echo "[FAIL] pre-commit: credential pattern detected -- commit rejected"
        echo "       Pattern: ${pattern}"
        echo "       Matches:"
        echo "$matches" | head -5 | sed 's/^/         /'
        echo ""
        echo "       If this is a false positive, either:"
        echo "         1. Move the value to ~/.secrets/ and reference via env var name"
        echo "         2. Use a placeholder value (CHANGE_ME / YOUR_TOKEN_HERE)"
        echo ""
        FAIL=1
    fi
done

# Check for long bare values in env-style lines (VAR=realvalue)
# Excludes comment lines, empty values, and known-safe structural values.
# 2026-08-24: added two more exemptions after real false positives --
# a bare filesystem path (VAR=/opt/...) is structural, not a secret; and
# a GPG key FINGERPRINT is meant to be public by design (that's the whole
# point of publishing one -- see security/signing.env's own comment on
# AGENT_SIGNING_KEY_FINGERPRINT, "gated... never on secrecy of this key
# itself"), so a variable name containing FINGERPRINT is exempted on the
# name alone rather than trying to pattern-match hex-vs-random values.
# CORRECTED 2026-08-26 (H-6, same class as the pattern loop above):
# exemptions now checked only against the matched KEY=VALUE assignment
# itself (first ~80 chars after the match start), not the full line.
env_candidates=$(echo "$STAGED" | grep -E "^\+" 2>/dev/null | grep -v "^+++" 2>/dev/null | \
    grep -v "^+\s*#" 2>/dev/null | \
    grep -E "^\+[A-Z][A-Z0-9_]{3,}=[A-Za-z0-9/+]{28,}" 2>/dev/null || true)
env_matches=""
if [ -n "$env_candidates" ]; then
    while IFS= read -r cand_line; do
        [ -z "$cand_line" ] && continue
        assignment=$(echo "$cand_line" | grep -oE "^\+[A-Z][A-Z0-9_]{3,}=[A-Za-z0-9/+]{0,80}" | head -1)
        [ -z "$assignment" ] && assignment="$cand_line"
        if echo "$assignment" | grep -qE "^\+[A-Z0-9_]*=/"; then continue; fi
        if echo "$assignment" | grep -qE "FINGERPRINT"; then continue; fi
        if echo "$assignment" | grep -qE "CHANGE_ME|YOUR_|example|localhost|127\.0\.0|http|REDACTED"; then continue; fi
        env_matches="${env_matches}${cand_line}"$'\n'
    done <<< "$env_candidates"
fi
if [ -n "$env_matches" ]; then
    echo ""
    echo "[FAIL] pre-commit: possible raw credential in env assignment -- commit rejected"
    echo "       Matches:"
    echo "$env_matches" | head -5 | sed 's/^/         /'
    echo ""
    echo "       Store values in ~/.secrets/ and run populate-secrets.sh instead."
    echo ""
    FAIL=1
fi

if [ "$FAIL" -eq 1 ]; then
    exit 1
fi

exit 0
