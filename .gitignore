venv/
__pycache__/
.claude/settings.local.json
# 2026-09-20: stray loose SQLite artifacts (e.g. dispatch-chat.db landing in
# the repo root) -- no .db file is tracked in git today, so this is safe;
# real state lives under /var/lib/corporatetraveldc/, never the repo root.
*.db
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
# Python packaging output (setup.py/pyproject builds) anywhere in the tree.
build/
# 2026-10-07 (security review 05): the build-integrity policy, the tools lock and
# the build tooling live in build/ and scripts/build/ and MUST be tracked and
# covered by the signed manifest. The blanket rule above hid them from git and
# from sign-manifest.sh (it uses --exclude-standard).
!/build/
!/scripts/build/

# Frontend build output and dependencies — generated during container build
src/runner/frontend/node_modules/
src/runner/static/

# Ollama Modelfiles — committed to private repo; public repo uses Modelfile.*.template only

# Credentials and keys — never commit
.ssh/
.pki/
.proton-bridge-credentials
.cloudflared/
.Xauthority
.claude/.credentials.json
.claude/dispatch/admin-tokens
.config/gh/hosts.yml
.config/rpi-connect-auth
.config/rpcc/
.config/com.raspberrypi.connect/
.linkedin-mcp/

# Browser data (Claude desktop / Chromium / Firefox)
.config/Claude/
.config/chromium/
.config/mozilla/

# Binary desktop databases
.config/dconf/

# Large binaries / installers
*.deb
*.flatpakref

# Ephemeral Claude Code runtime data
.claude/plugins/cache/
.claude/backups/
.claude/cache/
.claude/file-history/
.claude/history.jsonl
.claude/mcp-needs-auth-cache.json
.claude/paste-cache/
.claude/projects/*/[0-9a-f][0-9a-f][0-9a-f][0-9a-f]*
.claude/projects/**/*.jsonl
.claude/projects/*/subagents/
.claude/plugins/cache/
.claude/sessions/
.claude/shell-snapshots/
.claude/stats-cache.json
.claude/.last-cleanup
.claude/.last-update-result.json

# Shell / system ephemera
.bash_history
.viminfo
.wget-hsts
.xsession-errors
.xsession-errors.old
.sudo_as_admin_successful
.dmrc

# Package manager caches
.cache/
.npm/
.var/
.local/

# Personal / ephemeral outputs
Documents/
*claudecodeprompt*.md
*claude-code-prompt*.md

# Runtime secrets — never commit
secrets.env
**/secrets.env
dispatch-secrets.env
**/dispatch-secrets.env
# Scoped per-demo-instance secrets (2026-08-26, Opus blind review C-22
# follow-up) -- demo-secrets.env for the current public demo, and the
# same *-demo-secrets.env naming convention for any future role-specific
# variant (ea-demo-secrets.env, travel-agent-demo-secrets.env, an
# internal-only longitudinal-archive-demo-secrets.env, etc.) -- see
# config/demo-secrets.env.example.
*demo-secrets.env
**/*demo-secrets.env
# Scoped per-third-party-container secrets (2026-08-26, Opus blind review
# C-4) -- same convention extended to every non-CTDI image that used to
# load the full dispatch-secrets.env: ntfy-secrets.env,
# ultrafeeder-secrets.env, piaware-secrets.env, planefinder-secrets.env,
# airnavradar-secrets.env, fr24feed-secrets.env. See the matching
# config/*-secrets.env.example templates.
*-secrets.env
**/*-secrets.env

# SELinux policy build artifacts -- compiled from the .te at apply time.
# 2026-09-24: these landed in the repo from an in-tree `checkmodule` build and
# broke the signed manifest, because sign-manifest.sh hashes untracked-but-not-
# ignored files. Only the .te is source; .mod/.pp are regenerated every apply.
selinux/*.mod
selinux/*.pp
