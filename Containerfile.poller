FROM python:3.13-slim

LABEL org.opencontainers.image.title="corporatetraveldc-poller" \
      org.opencontainers.image.description="Corporate Travel DC Dispatch — poller + skill scheduler"

WORKDIR /app

# gnupg: needed at runtime by scripts/verify-manifest.sh (signed-manifest
# integrity check, see docs/COMPLIANCE_SECURITY.md "Signed Manifest
# Integrity") -- common/llm.py's generate()/ollama_post_with_retry() verify
# the calling skill's own source file (and, for dedicated models, its
# Modelfile) against the signed manifest before ever reaching Ollama.
RUN apt-get update \
 && apt-get install -y --no-install-recommends gnupg \
 && rm -rf /var/lib/apt/lists/*

# 2026-09-01: box runs a permanently-busy shared LLM chat tier (150%+ CPU
# sustained) alongside 30+ containers -- pip's 15s default read-timeout is
# too tight under that contention and kills slow-but-alive downloads,
# surfacing as "Connection interrupted"/ResolutionImpossible mid-build.
ENV PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=10

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# src/ kept at src/ (not flattened to .) so the container's internal layout
# matches the repo's own relative paths 1:1 -- the signed manifest's entries
# (e.g. "src/common/llm.py") resolve correctly against this image without
# any path-translation logic in the checker.
COPY src/ src/
COPY scripts/verify-manifest.sh scripts/verify-manifest.sh
COPY scripts/verified-exec.sh scripts/verified-exec.sh
COPY security/trusted-signing-key.pub.asc security/trusted-signing-key.pub.asc
# 2026-08-25 fix (Opus blind review C-4 follow-up): verify-manifest.sh
# now requires signing.env (SIGNING_KEY_FINGERPRINT/AGENT_SIGNING_KEY_
# FINGERPRINT) to pin the signing key -- it was never copied into any
# image before, so every verify-manifest.sh/verified-exec.sh call
# inside a container started failing closed the moment that fix
# shipped (confirmed live: corporatetraveldc-demo-api's verified-exec-
# wrapped startup crash-looped on "missing security/signing.env").
# Contains only GPG fingerprints, no private-key/passphrase material --
# safe to bake in the same as the pubkey above.
COPY security/signing.env security/signing.env
COPY MANIFEST.sha256 MANIFEST.sha256.asc ./
# 2026-08-10: caught in the post-rebuild smoke test -- common/llm.py's
# _verify_before_inference() checks a dedicated model's Modelfile
# (corporatetraveldc.<suffix>, repo root) against the signed manifest
# before every Ollama call, but no Containerfile ever copied these in --
# every LLM-calling skill was silently falling back to deterministic mode
# in every container, always, since the file could never be found. Whole-
# glob copy (not per-model) so a newly added Modelfile never needs a
# Containerfile edit to be reachable here.
COPY corporatetraveldc.* ./
RUN chmod +x scripts/verify-manifest.sh scripts/verified-exec.sh

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

CMD ["python3", "-m", "poller.main"]
