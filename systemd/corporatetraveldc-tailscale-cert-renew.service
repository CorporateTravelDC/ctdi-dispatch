[Unit]
Description=Renew Tailscale HTTPS cert for corporatetraveldc-dispatch.tailxxxxxxx.ts.net
After=tailscaled.service network-online.target
Wants=network-online.target

[Service]
# 2026-10-04 (duel C1): root runs the INSTALLED copy (root:root, /usr/local/libexec/ctdc),
# never the operator-writable checkout. After each sign: sudo scripts/install-root-copies.sh
# && sudo systemctl daemon-reload.
Type=oneshot
ExecStart=/usr/local/libexec/ctdc/renew-tailscale-cert.sh
