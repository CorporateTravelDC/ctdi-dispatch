# Daily 02:15 ET (clear of 00:05 data-usage-snapshot, 00:25 transport-pattern-
# digest, 01:00 trains-yachts-daily-watch, 01:35 dns-restart); idempotent, so
# daily is cheap though the cert renews only every ~90 days.
[Unit]
Description=Daily NTS cert-refresh check, 02:15 ET

[Timer]
OnCalendar=*-*-* 02:15:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
