[Unit]
Description=Run ops-brief every hour on the hour :00 (offset from ep-advance at :30 so Ollama jobs never stack; script adds 6h trend at 00/06/12/18 ET)
Requires=corporatetraveldc-ops-brief.service

[Timer]
OnCalendar=*-*-* *:00:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
