// corporatetraveldc tailnet ACL policy.
//
// Mirrors the dispatch/runner tiered-auth model (src/auth/auth.py,
// 2026-07-17): Tailscale identity alone grants NO application tier --
// resolve_tier only trusts the X-CTDI-Public marker and a bearer token.
// This policy's job is strictly network-layer reachability, one level
// below and independent of the app's own tiers. Do NOT feed Tailscale
// identity/capability grants back into resolve_tier -- that reintroduces
// the exact trust-the-tailnet gap this whole change closed.
//
// Default posture is explicit-allow: anything not listed below is
// denied, including any device added to this tailnet in the future.
// Replaces the stock personal-tailnet default of
//   "acls": [{"action": "accept", "src": ["*"], "dst": ["*:*"]}]
//
// PROCESS: /etc/corporatetraveldc/PORTS.md requires a new row in the
// SAME commit as whatever claims a port. Whenever that row documents a
// bind scope wider than 127.0.0.1/::1 (i.e. it becomes reachable from
// the tailscale interface, which owns 0.0.0.0/tailscale-IP binds too),
// add the matching tcp:/udp: entry to the grant below in that same
// commit. This file is the tailnet-reachability half of that same
// discipline -- treat a new wide-bind port with no matching grant here
// as a bug, same as PORTS.md does for an unregistered port.
//
// Current coverage (every port in PORTS.md bound wider than loopback,
// as of 2026-07-17):
//   22    sshd
//   53    Pi-hole DNS (exit-node / DNS-override clients)
//   80/443 nginx -- every public vhost reachable directly over the
//          tailnet IP too, incl. the tailscale-only runner vhost and
//          the planned dispatch-runner.example.com
//          demo-archiver stub (README.md) once built -- it's slated to
//          reuse this same vhost/port, not a new one, so no new grant
//          is needed for it unless that changes.
//   2586  ntfy (direct app subscription, bypassing the public vhost)
//   3000  Open WebUI
//   8000  dispatch (still token-gated at the app layer)
//   8001  runner (still token-gated at the app layer)
//   8080  ultrafeeder (ADS-B feed)
//   9080  acarsrouter (no nginx vhost in front of it -- tailnet is the
//          only auth-adjacent boundary it has at all right now)
//   11434 ollama
//
// Deliberately NOT granted -- loopback-only today, no tailnet exposure
// to restrict or preserve: 631 (cups), 5335 (unbound), 8002 (www
// contact-form backend), 8082 (mcpo), 8091 (Pi-hole admin, reachable
// via the public vhost's 80/443 instead), 9081 (acarshub, same). If any
// of these is meant to go tailnet-direct, add its row to PORTS.md and
// its port here in the same change.
{
	"tagOwners": {
		"tag:corporatetraveldc-server": ["owner@example.com"],
	},

	"acls": [
		// Intentionally empty -- everything expressed as "grants" below.
	],

	"grants": [
		// Owner's own devices (phone, laptop) may reach the tailnet-facing
		// services on the dispatch server. Single-owner tailnet today, but
		// tag-scoping means any future device added to this tailnet gets
		// NO access by default instead of inheriting a wildcard allow.
		{
			// dst matches both the tag (once corporatetraveldc-dispatch is
			// re-advertised with it -- requires root on the box, a separate
			// manual step) AND autogroup:self ("my own devices"), so this
			// grant works immediately with no tagging dependency. Raw tailnet
			// IPs aren't accepted as a dst value by this API, so autogroup:self
			// is the safe stand-in until tagging happens -- note it also permits
			// the owner's OTHER devices to reach each other on these ports (all
			// owned by the same identity), not just device-to-server. Drop
			// autogroup:self later, once tagging is confirmed working, to
			// tighten that back down.
			"src": ["owner@example.com"],
			"dst": ["tag:corporatetraveldc-server", "autogroup:self"],
			"ip": [
				"tcp:22",     // sshd -- see also the "ssh" block below
				"tcp:53",     // Pi-hole DNS -- exit-node / DNS-override clients
				"udp:53",
				"tcp:80",     // nginx -- every public vhost, direct over tailnet
				"tcp:443",    // nginx TLS + tailscale-dispatch-runner.conf vhost
				"tcp:2586",   // ntfy -- direct app subscription
				"tcp:3000",   // Open WebUI
				"tcp:8000",   // dispatch -- direct tailnet access, still token-gated
				"tcp:8001",   // runner -- direct tailnet access, still token-gated
				"tcp:8080",   // ultrafeeder (ADS-B feed)
				"tcp:9080",   // acarsrouter
				"tcp:11434",  // ollama -- OLLAMA_BASE_URL points here from other devices
			],
		},
	],

	"ssh": [
		{
			"action": "check",
			"src": ["owner@example.com"],
			"dst": ["tag:corporatetraveldc-server", "autogroup:self"],
			"users": ["autogroup:nonroot", "corporatetraveldc"],
		},
	],
}
