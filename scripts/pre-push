#!/bin/bash
# .git/hooks/pre-push — credential scanner + public mirror guard
# Source of truth: scripts/pre-push (keep in sync)
#
# Responsibilities:
#   1. Block direct `git push public` — use scripts/push-public.sh instead.
#   2. Credential pattern scanner — rejects commits containing known secret patterns.
#
# 2026-08-13: deliberately does NOT auto-sync the public mirror after a push
# to origin/main -- that used to happen silently as a side effect of this
# hook. Publishing to the public repo is now an explicit, separate step --
# see scripts/push-and-sync.sh -- so nothing reaches the public mirror
# without a confirmed-successful origin push and a human running the sync
# on purpose.

set -euo pipefail

# 2026-08-24: same fix as scripts/pre-commit, same root cause -- see that
# file's comment for the full incident writeup. A shadowing `grep` shell
# function (Claude Code CLI's shell integration, confirmed instance)
# mangled `grep -E "^+"`'s diff-line filtering badly enough that removed
# lines matched an added-only check. Strip any shadow before scanning.
unalias grep 2>/dev/null || true
unset -f grep 2>/dev/null || true

remote="${1:-}"
remote_url="${2:-}"

# ── 1. Public mirror guard ──────────────────────────────────────────────────────
# Direct pushes to public risk exposing dispatch-secrets.env.
#
# 2026-08-25 fix (Opus blind review C-0c): this used to check only $1 (the
# remote NAME git was invoked with) against the literal string "public".
# `git push public ...` sets $1="public" and is caught -- but
# `git push https://github.com/.../ctdi-dispatch.git ...` (the same
# destination, invoked by raw URL instead of the configured remote name)
# sets $1 to that URL, not "public", and sailed straight through with zero
# scrub step. Now also resolves the "public" remote's actual configured
# URL and matches against $2 (the URL git always passes as the second
# hook argument) -- and against $1 too, since git sets $1 equal to the URL
# when no matching named remote is used at all.
public_remote_url="$(git remote get-url public 2>/dev/null || true)"
# CORRECTED 2026-08-26 (Opus blind review H-6): the URL comparison used
# to be plain string equality against whatever spelling `git remote
# get-url public` happened to return -- but git accepts (and this box's
# own history shows real use of) multiple equivalent spellings of the
# same destination that never string-match each other: with/without a
# trailing ".git", with/without a trailing slash, the SSH shorthand
# (git@github.com:Org/repo.git) vs the HTTPS form
# (https://github.com/Org/repo.git), and host-case differences. A push
# to any of the 3 spellings that don't happen to equal the configured
# remote's exact string sailed straight through unscrubbed. Normalize
# both sides the same way before comparing: lowercase, strip a trailing
# "/" then a trailing ".git", and rewrite the SSH shorthand form to the
# same "host/path" shape the HTTPS form already has.
_normalize_git_url() {
    local u="$1"
    u="${u,,}"                                  # lowercase
    u="${u%/}"                                   # strip one trailing slash
    u="${u%.git}"                                 # strip trailing .git
    if [[ "$u" =~ ^git@([^:]+):(.+)$ ]]; then
        u="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    else
        u="${u#https://}"
        u="${u#http://}"
        u="${u#ssh://git@}"
    fi
    printf '%s' "$u"
}
norm_public_url="$(_normalize_git_url "$public_remote_url")"
norm_remote="$(_normalize_git_url "$remote")"
norm_remote_url="$(_normalize_git_url "$remote_url")"
if [[ -z "${CTDI_PUSH_PUBLIC_INTERNAL:-}" ]] && \
   { [[ "$remote" == "public" ]] || \
     { [[ -n "$norm_public_url" ]] && \
       { [[ "$norm_remote_url" == "$norm_public_url" ]] || [[ "$norm_remote" == "$norm_public_url" ]]; }; }; }; then
    echo ""
    echo "[pre-push] Direct push to public mirror intercepted."
    echo "           Use the wrapper instead — it auto-injects the dispatch-secrets.env"
    echo "           gitignore without touching private/main:"
    echo ""
    echo "               bash scripts/push-public.sh"
    echo ""
    exit 1
fi

# ── 2. Credential pattern scanner ──────────────────────────────────────────────
# Read refs being pushed from stdin; also scan commits for credential patterns.
# stdin format: <local ref> SP <local sha1> SP <remote ref> SP <remote sha1> LF

PUSHING_MAIN=false
FAIL=0
SCAN_RANGE=""

while read local_ref local_sha remote_ref remote_sha; do
    # Track whether main is being pushed to origin
    if [[ "$remote" == "origin" && "$remote_ref" == "refs/heads/main" ]]; then
        PUSHING_MAIN=true
    fi

    # Build commit range to scan.
    # local_sha all-zero  -> this ref is being DELETED, nothing to scan.
    # remote_sha all-zero -> brand-new ref on the remote; there's no prior
    #   state to diff against, so scan against git's well-known empty-tree
    #   hash instead of the null sha itself. (Using local_sha alone here
    #   previously meant "diff working tree vs local_sha", which is empty
    #   whenever the working tree is clean -- silently scanned nothing on
    #   every new-branch push. Found via a direct self-test 2026-08-13.)
    EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
    if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
        SCAN_RANGE=""
    elif [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        SCAN_RANGE="${EMPTY_TREE}..${local_sha}"
    else
        SCAN_RANGE="${remote_sha}..${local_sha}"
    fi

    # Scan new commits being pushed for credential patterns
    # CORRECTED 2026-08-27, same class of fix as scripts/pre-commit same
    # day: sk_adjs_/sk-ant-api/github_pat_ used to be bare prefixes with
    # no required characters after them -- unlike ghp_/ghs_ below, which
    # already require at least one token char to follow. A real
    # security-report doc that merely NAMES the credential type ("zero
    # GitHub `ghp_`/`github_pat_` tokens found") tripped this every time,
    # with no actual leaked value present at all -- confirmed live, the
    # match was inside a doc's own scan-summary prose. Now requires a
    # minimum run of real token-shaped characters after each prefix, same
    # discipline ghp_/ghs_ already had.
    PATTERNS=(
        "sk_adjs_[A-Za-z0-9_\-]{10,}"
        "sk-ant-api[A-Za-z0-9_\-]{10,}"
        "github_pat_[A-Za-z0-9_]{20,}"
        "ghp_[A-Za-z0-9]"
        "ghs_[A-Za-z0-9]"
        "Bearer [A-Za-z0-9_\-\.]{20,}"
        "taile[0-9a-f]{8}"
    )

    if [[ -n "$SCAN_RANGE" ]]; then
        DIFF=$(git diff "${SCAN_RANGE}" --unified=0 2>/dev/null || true)

        for pattern in "${PATTERNS[@]}"; do
            # CORRECTED 2026-08-26 (Opus blind review H-6): the exemptions
            # below (CHANGE_ME/example/placeholder/REDACTED/<...>/.../
            # deadbeef) used to be `grep -v` over the WHOLE matched line --
            # a genuine leaked token survives untouched as long as ANY word
            # in that placeholder list appears ANYWHERE else on the same
            # line, e.g. a real `ghp_...` token followed by a trailing
            # "# example" comment, or on the same diff line as an unrelated
            # "<some other tag>". Confirmed live via the exact hook
            # pipeline. Now scoped to a ~20-char window immediately around
            # the actual match, not the whole line -- a real token 40+
            # chars from the word "example" is no longer exempted, while
            # genuine inline illustrative values (the placeholder text
            # directly adjacent to the fake token) still are.
            candidates=$(echo "$DIFF" | grep -E "^\+" 2>/dev/null | grep -v "^+++" 2>/dev/null | \
                         grep -E "$pattern" || true)
            matches=""
            if [[ -n "$candidates" ]]; then
                while IFS= read -r cand_line; do
                    [[ -z "$cand_line" ]] && continue
                    window=$(echo "$cand_line" | grep -oE ".{0,20}(${pattern}).{0,20}" | head -1)
                    [[ -z "$window" ]] && window="$cand_line"
                    if ! echo "$window" | grep -qE "CHANGE_ME|YOUR_|example|placeholder|REDACTED|<[^>]*>|\.\.\."; then
                        if ! echo "$window" | grep -qi "deadbeef"; then
                            matches="${matches}${cand_line}"$'\n'
                        fi
                    fi
                done <<< "$candidates"
            fi
            if [[ -n "$matches" ]]; then
                echo ""
                echo "[FAIL] pre-push: credential pattern detected — push rejected"
                echo "       Pattern: ${pattern}"
                echo "       Matches:"
                echo "$matches" | head -5 | sed 's/^/         /'
                echo ""
                echo "       If this is a false positive:"
                echo "         1. Move the value to ~/.secrets/ and reference via env var name"
                echo "         2. Use a placeholder (CHANGE_ME / YOUR_TOKEN_HERE)"
                echo ""
                FAIL=1
            fi
        done

        # Env-var long-value scan. Same two exemptions added 2026-08-24 as
        # scripts/pre-commit: bare filesystem paths aren't secrets, and a
        # variable name containing FINGERPRINT denotes a GPG key fingerprint
        # (meant to be public by design -- see security/signing.env).
        # CORRECTED 2026-08-26 (H-6, same class as the pattern loop above):
        # exemptions now checked only against the matched KEY=VALUE
        # assignment itself (first ~80 chars after the match start), not
        # the full line -- a real secret followed by a trailing "# example"
        # comment on the same line no longer escapes detection.
        env_candidates=$(echo "$DIFF" | grep -E "^\+" 2>/dev/null | grep -v "^+++" 2>/dev/null | \
            grep -v "^+\s*#" 2>/dev/null | \
            grep -E "^\+[A-Z][A-Z0-9_]{3,}=[A-Za-z0-9/+]{28,}" 2>/dev/null || true)
        env_matches=""
        if [[ -n "$env_candidates" ]]; then
            while IFS= read -r cand_line; do
                [[ -z "$cand_line" ]] && continue
                assignment=$(echo "$cand_line" | grep -oE "^\+[A-Z][A-Z0-9_]{3,}=[A-Za-z0-9/+]{0,80}" | head -1)
                [[ -z "$assignment" ]] && assignment="$cand_line"
                if echo "$assignment" | grep -qE "^\+[A-Z0-9_]*=/"; then continue; fi
                if echo "$assignment" | grep -qE "FINGERPRINT"; then continue; fi
                if echo "$assignment" | grep -qE "CHANGE_ME|YOUR_|example|localhost|127\.0\.0|http|REDACTED"; then continue; fi
                env_matches="${env_matches}${cand_line}"$'\n'
            done <<< "$env_candidates"
        fi
        if [[ -n "$env_matches" ]]; then
            echo ""
            echo "[FAIL] pre-push: possible raw credential in env assignment — push rejected"
            echo "       Matches:"
            echo "$env_matches" | head -5 | sed 's/^/         /'
            echo ""
            echo "       Store values in ~/.secrets/ and run populate-secrets.sh instead."
            echo ""
            FAIL=1
        fi
    fi
done

if [[ "$FAIL" -eq 1 ]]; then
    exit 1
fi

if [[ "$PUSHING_MAIN" == "true" ]]; then
    echo "[pre-push] Pushing main -- remember to run scripts/push-and-sync.sh"
    echo "           (or scripts/push-public.sh directly) to update the public"
    echo "           mirror once this push completes. Not automatic."
fi

exit 0
