[Unit]
Description=Corporate Travel DC -- weekly Second Brain consolidation dump (Opus, Gate 2 of the documentation policy)
# 2026-08-26: same headless-claude pattern as docs-drift-weekly, which has
# a confirmed real failure mode (a scheduled fire landing during an
# exhausted Claude usage window exits non-zero with no retry -- see
# docs/LIVE_STATE_CHECK_2026-08-26.md finding 3). This unit is more
# important to catch a silent failure on than most: a missed dump means
# CLAUDE.md/memory never get consolidated that week. OnFailure pings ops
# immediately instead of waiting for next Sunday.
OnFailure=corporatetraveldc-unit-failure-notify@%n.service

[Service]
Type=oneshot
# PATH needed for the same reason as corporatetraveldc-claude-md-drift-daily:
# the systemd *user* manager's PATH doesn't include ~/.local/bin, where the
# `claude` CLI lives.
Environment=PATH=/home/corporatetraveldc/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/opt/corporatetraveldc/private/ctdi-dispatch-internal/scripts/second-brain-weekly-dump.sh
TimeoutStartSec=1800

[Install]
WantedBy=default.target
