[Unit]
Description=Run AAM daily watch 15:30 ET, second daily run (see corporatetraveldc-aam-daily-watch.timer for the 07:30 morning run -- same service, two independent schedules for 2x/day coverage per operator request 2026-08-06)
Requires=corporatetraveldc-aam-daily-watch.service

[Timer]
OnCalendar=*-*-* 15:30:00 America/New_York
Persistent=false
# 2026-08-06: systemd timers default to triggering a SAME-NAMED service
# unless told otherwise -- without this line the timer would look for a
# nonexistent corporatetraveldc-aam-daily-watch-pm.service instead of
# reusing the existing AM service. Requires= in [Unit] above is only a
# dependency ordering directive, it does NOT set the trigger target.
Unit=corporatetraveldc-aam-daily-watch.service

[Install]
WantedBy=timers.target
