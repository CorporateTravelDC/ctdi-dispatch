[Unit]
Description=Run ep-advance-venues once daily at 06:10 ET (plus manual trigger)
Requires=corporatetraveldc-ep-advance-venues.service

[Timer]
# 06:10 ET -- ahead of the day's EP activity, off the top-of-hour
# daily-watch herd's :00/:15/:30/:45 grid (same collision-avoidance
# reasoning as ep-advance.timer's :35 mark). Manual re-run any time:
# `python3 src/poller/skills/ep_advance_venues.py` refreshes the cached
# section the hourly ep-advance brief splices in.
OnCalendar=*-*-* 06:10:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
