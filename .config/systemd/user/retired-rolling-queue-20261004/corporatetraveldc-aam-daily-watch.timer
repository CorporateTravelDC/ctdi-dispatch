[Unit]
Description=Run AAM watch once nightly at 21:00 ET (overnight-only window, see 2026-09-06 note)
# 2026-09-06 OVERNIGHT-ONLY (operator directive): every long-running LLM
# digest/watch now runs ONCE nightly inside the 20:00-05:30 ET window and
# never during the day. Evidence (thermal-ingest-guard 2-min readings,
# Sep 2-6): load 19:00-06:00 ET mean 5-9, max <=27, zero readings >=30;
# 09:00-13:00 mean 19-24, max 40-58, every LOCKDOWN trip. The same watch
# that takes 5-25min at 03:00 took 50-88min mid-morning because it queued
# behind its siblings on the single-slot report LLM (-np 1) and dragged
# load to 30+ for the whole morning. The previous every-90min grid (two
# OnCalendar lines, 3h offset, 2026-08-17) is retired. Slots are 40min
# apart, off the hourly ops-brief :05 / ep-advance :35 marks, clear of
# second-brain-daily 23:45 and transport-pattern-digest 00:25.
# Persistent=false is now doing double duty: a slot missed (box down,
# LOCKDOWN shed) is skipped, NOT fired at the next boot in daylight.
# Nightly order: executive-protection 20:20, aam 21:00, aviation 21:40,
# gig-economy 22:20, concierge-travel 23:00, trains-yachts 01:00.
# 2026-09-05: deliberately NO self-referential Requires=/Wants= here --
# that makes systemd start the service the instant this TIMER starts
# (i.e. every boot, at timers.target), independent of OnCalendar/
# Persistent. See docs/BOOT_STORM_TIMER_REQUIRES.md. The timer->service
# binding is implicit from the filename; the line was never needed.

[Timer]
OnCalendar=*-*-* 21:00:00 America/New_York
Persistent=false

[Install]
WantedBy=timers.target
