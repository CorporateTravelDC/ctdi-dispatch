[Unit]
Description=Corporate Travel DC -- staggered startup for the 18 non-ingest long-running containers (anti boot-storm)
# 2026-07-28: built as the counterpart to corporatetraveldc-boot-stagger.service
# (which already staggers the seven SWIM ingest units). Before this existed,
# poller, web, pusher, ultrafeeder, the full ACARS stack, both Nextcloud units,
# openwebui, protonbridge, ntfy, csexec-contact, and the demo/runner stack all
# carried their own WantedBy=default.target and fired in parallel the instant
# network-online.target was reached -- the same boot-storm pattern already
# fixed on the ingest side. This unit owns their startup instead, via
# scripts/stack-boot-ctl.sh, in a dependency-aware order.
#
# Runs BEFORE the ingest stagger (see After= in
# corporatetraveldc-boot-stagger.service) so the two staggered sequences
# don't overlap and compete for the same CPU/RAM/bandwidth headroom.
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=600
ExecStart=/opt/corporatetraveldc/private/ctdi-dispatch-internal/scripts/stack-boot-ctl.sh start

[Install]
WantedBy=default.target
