[Unit]
Description=Staggered startup for the seven SWIM ingest containers (anti boot-storm)
# 2026-07-28: built after two hard crashes in one morning traced to a boot
# storm -- all seven ingest-* containers (core/fdps/stdds/tfms/tbfm/itws/
# notam) used to fire in parallel via each unit's own WantedBy=default.target
# (now removed from those .container files, see the comment left in each).
# This unit owns their startup instead, calling the existing
# scripts/ingest-feed-ctl.sh in lightest-first order with a 20s stagger so
# they don't all slam RAM/CPU/bandwidth at the same instant a reboot (or a
# post-crash recovery) brings the user session back up.
After=default.target
After=corporatetraveldc-stack-boot-stagger.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/corporatetraveldc/private/ctdi-dispatch-internal/scripts/ingest-feed-ctl.sh start all --stagger=20 --order=lightest-first

[Install]
WantedBy=default.target
