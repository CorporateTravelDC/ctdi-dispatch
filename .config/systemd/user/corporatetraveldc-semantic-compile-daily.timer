[Unit]
Description=Run the second-brain semantic-layer compile 4x daily, fixed grid (02:52/06:02/12:02/18:02 ET)
# 2026-09-05: deliberately NO self-referential Requires=/Wants= here --
# that makes systemd start the service the instant this TIMER starts
# (i.e. every boot, at timers.target), independent of OnCalendar/
# Persistent. See docs/BOOT_STORM_TIMER_REQUIRES.md. The timer->service
# binding is implicit from the filename; the line was never needed.

[Timer]
# Fixed calendar grid, not OnUnitActiveSec -- see trains-yachts-daily-watch.timer's
# 2026-08-17 comment and entity-tracking-digest.timer's comment for why:
# OnUnitActiveSec re-arms from each unit's own activation time and coalesces
# onto the same second over time.
#
# 2026-09-03 (operator directive): widened from once-daily (03:47) to
# every 6 hours -- the fixed 00/06/12/18:02 grid deliberately includes a
# fire right at the midnight boundary, so "every 6 hours" and "on a day
# change" are the SAME schedule, not two separate ones to reconcile. :02
# (not :00) keeps this off the many jobs that fire on every hour's :00
# mark -- same "don't pile onto another skill's DB/WebDAV activity at the
# same instant" reasoning as the old :47 offset, just re-anchored to this
# wider grid. A THIRD, event-driven trigger lives in the sibling .path
# unit (corporatetraveldc-semantic-compile-daily.path), which fires
# immediately whenever second_brain.remember_text() writes a note to
# 01-Sources/manual/ (a "Jarvis reconciliation", see remember.py's
# 2026-09-03 comment) -- systemd coalesces a .path-triggered start that
# lands close to a .timer-triggered one into a single run, so no
# double-fire risk from having both armed.
#
# 2026-10-19 (lean-out L2 / D6, operator-approved stagger map): the 00:02 ET
# run (04:02Z under EDT) failed 6 of 14 times on lock/statement timeouts: it
# lands inside the 03:40Z backup (+10 min random, runs ~1.5-2 h), beside the
# 00:08 ET knowledge-graph compile, the 00:12 ET entity digest and the 00:05 ET
# data-usage snapshot. It moves to 02:52 ET (06:52Z EDT / 07:52Z EST): after
# the backup, after the 06:20Z (+10 min) airline-time-fidelity collector,
# inside the 03-10Z quiet hours (D7), still the first compile of the new day.
# The 06/12/18:02 ET runs are unchanged. Was: 00,06,12,18:02 ET.
OnCalendar=*-*-* 02:52:00 America/New_York
OnCalendar=*-*-* 06,12,18:02:00 America/New_York
# Still true: a missed fire (box down at the grid mark) now only costs up
# to 6h instead of 24h, but Persistent=true costs nothing to keep.
Persistent=true

[Install]
WantedBy=timers.target
