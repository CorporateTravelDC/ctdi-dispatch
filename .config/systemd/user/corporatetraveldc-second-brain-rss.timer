[Unit]
Description=Run second-brain RSS poller every 2 hours (real code, no-op until feeds are configured) -- offset to :10 (2026-07-28) so it never lands on top of ops-brief at :00
Requires=corporatetraveldc-second-brain-rss.service

[Timer]
OnCalendar=*-*-* 0/2:10:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
