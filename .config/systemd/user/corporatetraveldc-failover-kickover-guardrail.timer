[Unit]
Description=Every 5 minutes -- failover push/pull kickover guardrail (nws, notam)
# 2026-09-05: deliberately NO self-referential Requires=/Wants= here --
# that makes systemd start the service the instant this TIMER starts
# (i.e. every boot, at timers.target), independent of OnCalendar/
# Persistent. See docs/BOOT_STORM_TIMER_REQUIRES.md. The timer->service
# binding is implicit from the filename; the line was never needed.

[Timer]
# 2026-10-19 (lean-out L2 / F12 stagger map): *:0/5 -> *:01/5. Same cadence, off the
# shared :00/:05/:10.../:30 seconds where five */5 jobs, three */15 jobs and the */30
# integrity check all fired together (~102 starts at :00, ~96 at :30 per day).
OnCalendar=*:01/5
Persistent=false

[Install]
WantedBy=timers.target
