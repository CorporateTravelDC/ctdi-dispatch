[Unit]
Description=Fire the daily llama-hot/chat preventive restart at 03:00 ET (NOT a quiet slot -- collides with aam-daily-watch every day, see scheduled-llama-restart.sh's idle-wait for how that's handled)
# 2026-08-30: was Requires=, which pulls the service in the instant the
# TIMER unit itself is activated (enabled/started), not just at each
# scheduled fire -- confirmed live: enabling this timer triggered an
# immediate unplanned restart of both tiers mid-session, with
# aviation-daily-watch dying on "database is locked" in the resulting
# I/O thrash. Wants= only expresses ordering/pulling at actual timer
# elapse, matching every other timer on this box.
Wants=corporatetraveldc-llama-restart.service

[Timer]
OnCalendar=*-*-* 03:00:00 America/New_York
Persistent=true
# Persistent=true means a missed fire (box down at 03:00) runs on next
# boot instead of waiting a full day -- keeps the real gap between
# restarts inside the operator's <=24h cap even across a reboot.

[Install]
WantedBy=timers.target
