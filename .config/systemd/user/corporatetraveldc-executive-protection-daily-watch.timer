[Unit]
Description=Run executive-protection watch every 90min, anchored 08:45 ET (after trains-yachts 08:30, clear of hourly ops-brief/ep-advance :00/:30 marks)
Requires=corporatetraveldc-executive-protection-daily-watch.service

[Timer]
# 2026-08-17 (fable-timing-artifact-sweep): the OnCalendar-anchor +
# OnUnitActiveSec=90min combination does NOT preserve the sibling stagger
# the comment above assumed. OnUnitActiveSec re-arms from each unit's own
# ACTIVATION time, and systemd's default AccuracySec=1min coalesces nearby
# wakeups -- so one bunching event makes the convergence PERMANENT.
# Observed live today: five watch timers all fired at literally the same
# second (13:16:35, then again 14:46:36, exactly 90min later), producing a
# 6-deep Ollama queue, repeated 150s lock-timeout fallbacks (aam-daily
# 12:39/14:49, concierge 13:31, trains-yachts 13:35), and trains-yachts
# being KILLED at its 7000s TimeoutStartSec ceiling at 15:14 -- today's
# vault note lost. Replaced with a fixed 24h calendar grid (same 90min
# cadence, same anchor, stagger structurally guaranteed). A slot arriving
# while the previous run is still active is skipped entirely -- graceful
# load-shedding, same behavior the old comment believed it had.
OnCalendar=*-*-* 2/3:45:00 America/New_York
OnCalendar=*-*-* 1/3:15:00 America/New_York
# 2026-08-16: see aam-daily-watch.timer's matching comment -- same
# recurring-cadence addition, same graceful-skip-under-load behavior.
Persistent=false

[Install]
WantedBy=timers.target
