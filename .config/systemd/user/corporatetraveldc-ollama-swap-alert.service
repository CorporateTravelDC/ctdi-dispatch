[Unit]
Description=Alert the moment Ollama's cgroup touches swap at all (not just container-level)
# 2026-07-28: see scripts/ollama-swap-alert.sh header for the full incident
# context. This is a user-level unit because reading a system unit's cgroup
# accounting (systemctl show ollama --property=...) needs no root -- only
# writing MemorySwapMax on ollama.service itself does, which stays a manual,
# operator-applied drop-in.
After=default.target

[Service]
Type=simple
ExecStart=/opt/corporatetraveldc/private/ctdi-dispatch-internal/scripts/ollama-swap-alert.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
