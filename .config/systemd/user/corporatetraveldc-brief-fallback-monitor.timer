[Unit]
Description=Run brief-fallback-monitor hourly (briefs regenerate hourly; catch silent LLM->deterministic degradation)
# 2026-09-05: deliberately NO self-referential Requires=/Wants= here --
# that makes systemd start the service the instant this TIMER starts
# (i.e. every boot, at timers.target), independent of OnCalendar/
# Persistent. See docs/BOOT_STORM_TIMER_REQUIRES.md. The timer->service
# binding is implicit from the filename; the line was never needed.

[Timer]
# Briefs run at :04 (ops) / :34 (ep-advance); check at :50 so both hourly runs
# have completed and been journaled before we evaluate the window.
OnCalendar=*-*-* *:50:00
OnBootSec=9min
Persistent=false

[Install]
WantedBy=timers.target
