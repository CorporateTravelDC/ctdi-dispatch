[Unit]
Description=Trigger a knowledge-graph refresh after a successful semantic compile
Requires=corporatetraveldc-knowledge-graph-compile.service

[Path]
# The compiler replaces this sentinel only after its database commit.
PathModified=/var/lib/corporatetraveldc/second-brain-triggers/semantic-compiled
Unit=corporatetraveldc-knowledge-graph-compile.service

[Install]
WantedBy=paths.target
