[Unit]
Description=Trigger a knowledge-graph recompile whenever a Jarvis reconciliation note lands
Requires=corporatetraveldc-knowledge-graph-compile.service

[Path]
# New sibling to corporatetraveldc-semantic-compile-daily.path -- same
# sentinel, same 2026-09-03 operator directive, same "Jarvis reconciliation"
# definition (see that unit's comment and remember.py's 2026-09-03 comment
# for the full reasoning). Both .path units watch the identical file, so
# one remember_text() call arms both recompiles.
PathModified=/var/lib/corporatetraveldc/second-brain-triggers/manual-note-written
Unit=corporatetraveldc-knowledge-graph-compile.service

[Install]
WantedBy=paths.target
