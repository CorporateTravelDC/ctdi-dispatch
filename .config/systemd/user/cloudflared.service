[Unit]
Description=Cloudflare Tunnel — corporatetraveldc dispatch
After=network-online.target
Wants=network-online.target

[Service]
# --protocol http2: this host's uplink is a public WiFi hotspot (xfinitywifi),
# not a private/wired network. Its NAT times out idle UDP faster than QUIC's
# keepalive interval, causing constant stream drops/reconnects (305 in 11h
# on 2026-07-10). HTTP/2 is TCP-based and far more tolerant of that.
ExecStart=/usr/bin/cloudflared tunnel --protocol http2 --config /home/corporatetraveldc/.cloudflared/config.yml run
Restart=always
RestartSec=15
TimeoutStartSec=30
# 2026-08-27 (operator directive): this unit had NO cgroup priority at
# all before this -- default weight (100), same as an ordinary desktop
# process, despite being the box's only public ingress path (every
# CF-Access-gated hostname, the demo site, everything). Now matches the
# must-never-die tier alongside ntfy.container (9000) and this box's
# native pihole-FTL/unbound/tailscaled (10000 each, system.slice) --
# must never lose to Ollama or an ordinary production container.
Slice=production.slice
CPUWeight=10000

[Install]
WantedBy=default.target
