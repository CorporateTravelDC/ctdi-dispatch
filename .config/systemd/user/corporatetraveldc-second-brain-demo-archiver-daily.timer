[Unit]
Description=Run demo-archiver daily ingest at 04:15 ET (right after the 04:00 vault index scan, quiet period, no Ollama use so no stacking concern)
Requires=corporatetraveldc-second-brain-demo-archiver-daily.service

[Timer]
OnCalendar=*-*-* 04:15:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
