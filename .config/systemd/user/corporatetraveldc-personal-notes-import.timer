[Unit]
Description=Personal Notes -> vault one-way import, every 2 minutes (no-op until PERSONAL_NOTES_SRC_APP_PASSWORD is set)
Requires=corporatetraveldc-personal-notes-import.service

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
# Persistent so a missed interval (box asleep/busy) triggers one catch-up run
# rather than waiting a full cycle.
Persistent=true

[Install]
WantedBy=timers.target
