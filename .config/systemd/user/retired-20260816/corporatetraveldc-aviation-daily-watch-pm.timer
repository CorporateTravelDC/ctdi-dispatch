[Unit]
Description=Run aviation daily watch 15:45 ET, second daily run (see corporatetraveldc-aviation-daily-watch.timer for the 07:45 morning run -- same service, two independent schedules for 2x/day coverage per operator request 2026-08-06)
Requires=corporatetraveldc-aviation-daily-watch.service

[Timer]
OnCalendar=*-*-* 15:45:00 America/New_York
Persistent=false
# 2026-08-06: see corporatetraveldc-aam-daily-watch-pm.timer for why this
# explicit Unit= is required (default same-name trigger target bug).
Unit=corporatetraveldc-aviation-daily-watch.service

[Install]
WantedBy=timers.target
