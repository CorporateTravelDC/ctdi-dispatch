[Unit]
Description=Run ops-brief every hour at :05 (script adds 6h trend at 00/06/12/18 ET)
Requires=corporatetraveldc-ops-brief.service

[Timer]
# 2026-08-24: moved from :00 -> :05. The original :00/:30 split from
# ep-advance avoided THOSE two colliding with each other, but never
# accounted for the six *-daily-watch skills, which between them cover
# every :00/:15/:30/:45 mark every hour (X/3:MM:00 dual-cadence design).
# Historical SR-1 log data showed real fallback collisions -- e.g.
# aam-daily-watch/aviation-daily-watch/second-brain-daily all logging
# `fallback` in the same second at 00:00:40 -- confirming ops-brief's
# :00 mark was structurally guaranteed to collide with some daily-watch
# skill's own :00 slot every single hour, not occasional bad luck. :05
# is off every family member's grid. See CLAUDE.md's Ingest
# load-shedding section for the full LOCKDOWN/fallback-count history
# this is meant to reduce. First step only -- a broader restagger of the
# six-skill family itself is a candidate for a follow-up pass once a
# week of data shows whether this alone is enough.
OnCalendar=*-*-* *:05:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
