[Unit]
Description=Check corporatetraveldc-ingest memory every 2 minutes, restart if over threshold
# 2026-09-05: deliberately NO self-referential Requires=/Wants= here --
# that makes systemd start the service the instant this TIMER starts
# (i.e. every boot, at timers.target), independent of OnCalendar/
# Persistent. See docs/BOOT_STORM_TIMER_REQUIRES.md. The timer->service
# binding is implicit from the filename; the line was never needed.

[Timer]
# 2026-10-19 (lean-out L2 / F12): 1min -> 90s, so each check runs ~30 s after
# container-mem-watch (same 2-min cadence, OnBootSec=1min) has published its
# `podman stats` snapshot, which this job now reads instead of running
# podman stats itself (7 per run before). OnUnitActiveSec unchanged.
OnBootSec=90s
OnUnitActiveSec=2min
Persistent=false

[Install]
WantedBy=timers.target
