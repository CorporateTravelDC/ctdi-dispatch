[Unit]
Description=Run second-brain daily digest once a day at 23:45 ET (the definitive full-day capture)
# 2026-09-05: deliberately NO self-referential Requires=/Wants= here --
# that makes systemd start the service the instant this TIMER starts
# (i.e. every boot, at timers.target), independent of OnCalendar/
# Persistent. See docs/BOOT_STORM_TIMER_REQUIRES.md. The timer->service
# binding is implicit from the filename; the line was never needed.

[Timer]
OnCalendar=*-*-* 23:45:00 America/New_York
# 2026-08-16: added recurring cadence, same pattern/reasoning as the six
# daily-watch timers' matching comment. webdav_client.put() overwrites
# the same 01-Sources/daily/<date>.md path each run (no dedup/skip logic,
# confirmed by reading second_brain_daily.py) -- safe to rerun repeatedly,
# each firing just refreshes that day's note with a fresher operational
# snapshot (CPS/TFR/NOTAM/NWS/METAR/Amtrak/watchlist/OSINT), it doesn't
# create duplicates. Worst-case measured ceiling is 43min -- comfortable
# margin under a 2h interval.
# 2026-10-19 (lean-out L2, F7): the 120-min repeat removed. It made this
# "daily" job fire ~12x/day, each run one model call (~1.9k prompt / 350
# out tokens, ~1-1.3 h/day of the long-runner lane). The 23:45 ET run was
# always the definitive capture; intra-day refreshes are dropped.
# Old: OnCalendar 23:45 ET + OnUnitActiveSec=120min. New: OnCalendar only.
# SUPERSEDED 2026-10-19: OnUnitActiveSec=120min
Persistent=true

[Install]
WantedBy=timers.target

