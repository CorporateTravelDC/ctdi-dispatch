[Unit]
Description=llama.cpp chat tier (interactive Dispatch Drawer, permanent)
After=network-online.target corporatetraveldc-llama-hot.service
Wants=corporatetraveldc-llama-hot.service

[Service]
# Ollama migration (2026-08-27): replaces corporatetraveldc-pi5-chat.
# See common/llama_pool.py's module docstring for the full port map.
# num_ctx 4096 matches corporatetraveldc.chat's Modelfile exactly (see
# common/personas.py PERSONAS["chat"]).
#
# Incident 2026-08-27 (see llama-hot.service's own comment for the full
# writeup): After= alone only orders unit ACTIVATION, not readiness --
# systemd fires both ExecStarts within moments of each other regardless,
# which is exactly what caused the load1=41 spike. This ExecStartPre
# blocks on hot's /health actually returning 200 (model fully loaded, not
# just process started) before this unit's own llama-server touches the
# same file, so the two loads are genuinely sequential rather than merely
# unit-ordered.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do curl -sf http://100.x.x.x:8093/health >/dev/null && exit 0; sleep 2; done; echo "llama-hot did not become healthy in time" >&2; exit 1'
ExecStart=/usr/local/lib/ollama/llama-server \
    -m /var/lib/corporatetraveldc/models/phi3-mini-q4_0.gguf \
    --host 100.x.x.x --port 8094 \
    -np 1 -t 2 -c 4096 \
    --cache-ram 0 \
    --no-webui
Restart=always
RestartSec=5
Slice=production.slice
# A human is waiting on the reply here (see corporatetraveldc.chat's own
# comment: "a human is waiting on the reply") -- same priority tier as hot.
CPUWeight=9000

# 2026-08-30: memory governance, ported from the retired ollama.service.d/
# 20-resource-limits.conf -- same gap as llama-hot.service (see that
# unit's comment for the full writeup and the paired production.slice
# ceiling fix). Sized larger than hot: this tier also carries ALL
# report-tier traffic since 2026-08-27 (report-1/2 route here, see
# common/llm.py's ollama_post_with_retry()), so it sees longer prompts
# (live-measured up to 1013 tokens) and more concurrent demand. B taken
# from this same day's live measurement (swap peak 3.4G under
# contention), rounded up to 4096M for the report-tier headroom, same
# 100%/125%/150% formula.
MemoryLow=4096M
MemoryHigh=5120M
MemoryMax=6144M
# Same reasoning as llama-hot.service: zero swap converts the slow
# zram page-out/page-in thrash into fast reclaim or a loud, fast
# (Restart=always/RestartSec=5) self-healing OOM instead.
MemorySwapMax=0

[Install]
WantedBy=default.target
