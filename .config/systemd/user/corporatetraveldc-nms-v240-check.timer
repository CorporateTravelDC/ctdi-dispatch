[Unit]
Description=One-shot NMS v2.4.0 post-deploy check -- fires once ~30min after the FAA maint window (2026-08-08 0400-0600z / 0000-0200 EDT) closes
Requires=corporatetraveldc-nms-v240-check.service

[Timer]
OnCalendar=2026-08-08 02:30:00
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
