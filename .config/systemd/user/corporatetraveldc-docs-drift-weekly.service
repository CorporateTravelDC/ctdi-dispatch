[Unit]
Description=Corporate Travel DC -- weekly documentation drift check (one repo; live facts + doc claims checked deterministically, local-model narrative optional)
# 2026-10-16: Description no longer says "Fable, both repos": since the 2026-09-21
# rewrite the script shells out to no cloud model, and it checks this repo only.
# 2026-08-26: this unit has a confirmed real failure mode (a Sunday-09:00
# fire landing during an exhausted Claude usage window exits non-zero with
# no retry, per docs/LIVE_STATE_CHECK_2026-08-26.md's finding 3) and only
# runs weekly, so a silent failure sits in --failed for up to 7 days.
# OnFailure pings ops immediately instead.
OnFailure=corporatetraveldc-unit-failure-notify@%n.service

[Service]
Type=oneshot
# PATH added 2026-08-19. Without it this unit could never work: the systemd
# *user* manager's PATH is only /usr/local/bin:/usr/bin, but the `claude`
# CLI the script shells out to lives at ~/.local/bin/claude. Every run since
# the unit was installed died with
#   nohup: failed to run command 'claude': No such file or directory
# leaving a 65-byte log and no drift report. Requires
# `systemctl --user daemon-reload` to take effect; unproven until a run is
# observed to succeed (next scheduled fire: Mondays 09:00).
Environment=PATH=/home/corporatetraveldc/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/opt/corporatetraveldc/private/ctdi-dispatch-internal/scripts/weekly-doc-drift-check.sh
TimeoutStartSec=1800

[Install]
WantedBy=default.target
