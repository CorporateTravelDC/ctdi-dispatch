# corporatetraveldc-weekly-external-image-update.service
# 2026-09-03 standing rule (operator directive): weekly forced update-check
# for the ~11 external/third-party containers. See
# scripts/weekly-external-image-update.sh's header for the full rationale
# and the real Nextcloud-major-version-jump incident its alerting design
# is built around.
[Unit]
Description=Weekly forced update-check for external/third-party containers
# Only runs weekly, same as corporatetraveldc-docs-drift-weekly.service --
# a silent failure would sit in --failed for up to 7 days without this.
OnFailure=corporatetraveldc-unit-failure-notify@%n.service

[Service]
Type=oneshot
ExecStart=/opt/corporatetraveldc/private/ctdi-dispatch-internal/scripts/weekly-external-image-update.sh
