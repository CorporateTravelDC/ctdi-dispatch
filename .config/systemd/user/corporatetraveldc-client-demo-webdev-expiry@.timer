# corporatetraveldc-client-demo-webdev-expiry@.timer
# Generalized 2026-09-03 from an earlier one-off client-preview's expiry
# timer. This base template's own OnActiveSec=7d is NOT what enforces the
# expiry deadline -- found 2026-09-03 to be reboot-unsafe (monotonic from
# unit activation, resets every reboot; Persistent=true is a no-op on a
# monotonic timer per systemd.timer(5)). scripts/new-client-demo.sh
# overrides it per instance with a 10-instance.conf drop-in that clears
# OnActiveSec= and pins an absolute OnCalendar=<creation+7d>
# America/New_York instead, where Persistent=true genuinely applies. The
# OnActiveSec=7d/Persistent=true below only matter if a timer instance is
# ever started without going through that generator -- not a supported
# path, kept as a sane-ish fallback rather than left unset.
[Unit]
Description=Fire once, 7 days after start -- expire client demo %i's webdev credential

[Timer]
OnActiveSec=7d
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
