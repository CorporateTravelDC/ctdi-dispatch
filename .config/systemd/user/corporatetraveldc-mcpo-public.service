[Unit]
Description=Corporate Travel DC -- mcpo (MCP-over-OpenAPI bridge for dispatch-mcp, PUBLIC-SAFE toolset only)
Documentation=https://github.com/CorporateTravelDC/corporatetravel-dispatch-mcp
After=network-online.target
After=podman-user-wait-network-online.service

[Service]
Type=simple
Restart=always
RestartSec=10
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
# 2026-08-06: separate instance from corporatetraveldc-mcpo.service,
# built specifically to be safe to expose via the public mcp.
# hostname. DISPATCH_MCP_PUBLIC_SAFE=1 makes dispatch_mcp/server.py skip
# registering admin.py and second_brain.py (see
# dispatch_mcp/tools/__init__.py) -- neither module has any real
# per-caller authorization, so the only safe way to expose a subset
# publicly is a genuinely separate process that never loads those tools
# at all, not a shared instance with a gate bolted on top.
#
# Bound to loopback only, same as the private instance -- nginx
# (mcp.example.com.conf) is the sole path in from outside,
# setting X-CTDI-Public the same way every other public vhost does.
Environment=DISPATCH_MCP_PUBLIC_SAFE=1
ExecStart=/home/corporatetraveldc/.local/bin/mcpo --host 127.0.0.1 --port 8083 -- /home/corporatetraveldc/mcp/dispatch-mcp/dispatch-mcp-wrapper.sh

[Install]
WantedBy=default.target
