# corporatetraveldc-poller.container
# Quadlet — ~/.config/containers/systemd/ under corporatetraveldc
# Manage: systemctl --user {start,stop,status,restart} corporatetraveldc-poller

[Unit]
Description=Corporate Travel DC — poller + skill scheduler
After=network-online.target

[Container]
Memory=1536m
# No additional swap beyond the RAM cap -- forces a clean OOM-kill
# instead of swap-thrashing (zram) if a container leaks past Memory=.
PodmanArgs=--memory-swap=1536m
Image=localhost/corporatetraveldc-poller:latest

# All persistent state: DB, SR-1 log, SR-2 hashes, brief/summary text
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z

# Trigger queue — poller reads trigger files dropped by web admin endpoints
Volume=/run/corporatetraveldc:/run/corporatetraveldc:z

# Permanent watchlist files — poller's WatchlistFileWatcher hot-reloads these
Volume=/opt/corporatetraveldc/ctdi-dispatch-internal/watchlists:/opt/corporatetraveldc/watchlists:ro,z

EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
AutoUpdate=local

[Service]
# Proportional CPU share, not a hard pin -- kernel scheduler enforces
# live, every tick. Only matters when something else (notably Ollama,
# CPUWeight=500) is actually contending for CPU right now; an idle box
# still lets this container burst across all cores for free.
CPUWeight=100
# Hard ceiling regardless of contention -- never more than 3 of the
# Pi's 4 cores for this container alone. See CLAUDE.md "Container
# resource limits".
CPUQuota=300%
Restart=always
RestartSec=10
TimeoutStartSec=30

[Install]
WantedBy=default.target
