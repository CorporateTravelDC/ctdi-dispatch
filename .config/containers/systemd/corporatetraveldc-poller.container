# corporatetraveldc-poller.container
# Quadlet — ~/.config/containers/systemd/ under corporatetraveldc
# Manage: systemctl --user {start,stop,status,restart} corporatetraveldc-poller

[Unit]
Description=Corporate Travel DC — poller + skill scheduler
After=network-online.target

[Container]
Memory=1536m
# No additional swap beyond the RAM cap -- forces a clean OOM-kill
# instead of swap-thrashing (zram) if a container leaks past Memory=.
PodmanArgs=--memory-swap=1536m
Image=localhost/corporatetraveldc-poller:latest
Environment=CORPORATETRAVELDC_UNIT=%N

# All persistent state: DB, SR-1 log, SR-2 hashes, brief/summary text
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
Volume=corporatetraveldc-pgsql-sock:/var/run/postgresql

# Trigger queue — poller reads trigger files dropped by web admin endpoints.
# 2026-09-20: found live -- this comment existed with no Volume= line under
# it. /run isn't shared between containers unless explicitly mounted, so
# web wrote trigger JSON into its own private /run/corporatetraveldc and
# poller glob-watched its own separate, always-empty one -- every
# /admin/push-alert (and any other file-trigger action) silently never
# fired. trigger_log rows got created fine (shared DB), so this looked
# like success (202 Accepted) while never actually delivering. Confirmed:
# corporatetraveldc-web.container has the matching gap too.
Volume=corporatetraveldc-triggers:/run/corporatetraveldc

# Permanent watchlist files — poller's WatchlistFileWatcher hot-reloads these
# 2026-09-23: found live, and it is the SAME failure shape as the trigger-queue
# gap documented above -- this comment existed with no Volume= line under it, so
# the poller looked at its own empty /opt/corporatetraveldc/watchlists and logged
# "permanent_trains.json not found, skipping" on every start. Harmless so far
# only because the four permanent_*.json files are seed data that web merges into
# Postgres (_merge_permanent_file), and the poller reads the DB -- all 304
# perm-train-* entries were present in watchlist_entries while this was broken.
# The real exposure was silent: hand-editing any of these files would never have
# reached the poller. Read-only because the poller only ever reads them; web is
# the writer, and web has the matching gap (see its own .container).
Volume=/opt/corporatetraveldc/watchlists:/opt/corporatetraveldc/watchlists:ro,z

EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
AutoUpdate=local

[Service]
# 2026-08-06: dedicated slice, separate from app.slice (where the
# interactive desktop session -- Brave/Claude Desktop -- lives). Lets
# app.slice carry its own memory ceiling without also capping
# production. See .config/systemd/user/production.slice and
# .config/systemd/user/app.slice.d/50-desktop-memory-ceiling.conf.
Slice=production.slice
# MemoryLow (2026-08-06): protects roughly a third of this container's
# own Memory= cap from kernel reclaim as long as memory is available
# elsewhere on the box -- prioritizes production over an unconstrained
# desktop session under real memory pressure, not just a cap after the
# fact. Previously 0 (unset) everywhere, including ollama.service.
MemoryLow=512M
# Proportional CPU share, not a hard pin -- kernel scheduler enforces
# live, every tick.
#
# 2026-09-04 (operator directive, real incident): this comment's
# "the only real contender is Ollama at weight 500" premise is dead --
# Ollama is fully retired (llama.cpp now), and the current landscape is
# llama-chat at CPUWeight=9000 and SWIM ingest at 7500. Poller at 100
# against those is a 90:1 / 75:1 ratio -- confirmed live tonight: a
# LOCKDOWN-triggered `systemctl stop` couldn't get SIGTERM handled in
# Podman's 10s window, escalated to SIGKILL (exit 137), and poller sat
# in `failed` state until manually restarted, extending a real outage.
# Same root cause and same fix as corporatetraveldc-web.container's
# CPUWeight=9000 change earlier the same night. Poller drives every
# fetch/skill/watchlist-sweep cycle -- it belongs in the same
# "must-never-die" tier as web/llama-chat/ntfy/cloudflared.
CPUWeight=9000
# Hard ceiling regardless of contention -- never more than 3 of the
# Pi's 4 cores for this container alone. See CLAUDE.md "Container
# resource limits".
CPUQuota=300%
Restart=always
RestartSec=10
TimeoutStartSec=30

[Install]
# 2026-07-28: no longer auto-started at login. This unit and 17 others
# used to fire simultaneously via WantedBy=default.target the instant
# network-online.target was reached -- a boot-storm RAM/CPU/bandwidth
# risk, the same class of bug already fixed on the SWIM ingest side
# (see corporatetraveldc-ingest-itws.container). Startup is now owned by
# corporatetraveldc-stack-boot-stagger.service, which staggers all 18 via
# scripts/stack-boot-ctl.sh in a dependency-aware order, before the
# existing corporatetraveldc-boot-stagger.service staggers in the seven
# SWIM ingest units.
# No WantedBy here on purpose -- do not re-add without re-introducing
# the boot storm.
