[Unit]
Description=Corporate Travel DC -- flight/train/maritime disruption + weather-vs-facility digest (2026-08-09/10 catch-up session)

[Container]
Memory=768m
PodmanArgs=--memory-swap=768m
Image=localhost/corporatetraveldc-poller:latest
Environment=CORPORATETRAVELDC_UNIT=%N
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
Volume=corporatetraveldc-pgsql-sock:/var/run/postgresql
# Same Nextcloud-via-nginx-vhost reasoning as corporatetraveldc-transport-pattern-digest.container --
# host.containers.internal cannot reach the loopback-only WebDAV port directly.
# See docs/COMPLIANCE_SECURITY.md, "Container Network Isolation".
Network=pasta:--map-gw
Environment=NEXTCLOUD_WEBDAV_BASE=http://host.containers.internal:80/remote.php/dav/files
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
# 2026-10-05 (duel M9, U7 rollout): only the secret NAMES the poller image reads
# (scripts/service-env/poller.allowlist -> generate.py --write), not dispatch-secrets.env
EnvironmentFile=/etc/corporatetraveldc/svc/poller.env
# 2026-09-06 LONG-RUNNER LOCK (operator directive: "No 2 long runners can run
# together either EVER"): flock on the box-wide unit lock wraps the whole
# run, so a second report container blocks here -- inside its own
# container, holding no model, no threads -- until the one ahead exits.
# It waits; it is never refused and never kills the run ahead of it.
# common/llama_pool.py takes a separate per-generation lock on top.
# 2026-10-04 (97b9075 pattern, see second-brain-daily.container): bounded lock wait.
#   -w 3600  max seconds to queue for the shared long-runner lock (was unbounded --
#            the queue wait ate the run budget and systemd killed the flock);
#   -E 75    give-up exits EX_TEMPFAIL = clean skip (SuccessExitStatus=75 below);
#   --verbose  logs the real lock wait on every run.
# TimeoutStartSec below = 3600 (queue wait) + 3000 (run budget, unchanged) + 100.
Exec=/usr/bin/flock --verbose -w 3600 -E 75 /var/lib/corporatetraveldc/llama-pool/long-runner-unit.lock scripts/verified-exec.sh python3 src/poller/skills/disruption_weather_digest.py

[Service]
# 2026-09-21 maintenance window (operator directive): long report-tier
# jobs may only run 23:00-05:00 America/New_York, so they never contend
# with the latency-sensitive flight/weather alert path. ExecCondition=
# (NOT ExecStartPre=) so an out-of-window firing SKIPS cleanly instead of
# marking the unit failed and paging via OnFailure=. Bounds are
# configurable: CTDC_MAINTENANCE_WINDOW_START/_END in dispatch.env.
# WARNING: this unit's OnCalendar= MUST stay inside the window or it will
# silently never run again. Verify with:
#   scripts/maintenance-window-guard.sh --check --at HH:MM
# 2026-10-04: enrolled in the rolling-window queue (scripts/lib/maintenance-queue.txt).
# Started by scripts/maintenance-dispatch.sh inside a quiet window drawn daily from the
# 30-day load profile; the fixed timer is retired. --rolling keeps a safety net: if the
# dispatcher ever starts this outside today's windows, the unit skips cleanly.
ExecCondition=/opt/corporatetraveldc/private/ctdi-dispatch-internal/scripts/maintenance-window-guard.sh --rolling
Slice=production.slice
MemoryLow=256M
Type=oneshot
# Phase 4 2026-08-15 (plan joyful-mapping-crown): reconciled with the
# skill's spike-measured Python timeouts (forced TIER2+ contention, same
# methodology as the Phase-3 53s baseline). Budget = 800s fixed
# (container start + generate() preflight gates 240+180 + load-phase
# allocation)
# + 810s digest call (max_retries=0) = 1610s -> 1700. A governor-pause retry-wait can still exceed this;
# systemd remains the deliberate backstop.
# 2026-08-17 (fable sweep): 1700 -> 3000. The 800s fixed allowance does not
# survive real Ollama-queue contention: live kill today -- manual run
# 15:27:38 EDT spent ~16min in slot-wait/load before its generate call
# (preload POST completed 15:44:20), hit this ceiling at 15:55:58, and the
# narrative that COMPLETED during stop-sigterm (15:57:27, 'narrative
# generated via Ollama/...disruption-weather-digest') was SIGKILLed before
# the vault write -- a finished generation thrown away. New budget: 800s
# fixed + 810s call + ~1200s queue-wait allowance = 2810 -> 3000. The
# daily-watch timer-grid fix in this same change removes most of the
# convergence that caused the wait.
# 2026-10-04: was the run-only budget (3000); the lock queue wait (flock -w 3600
# in Exec=) now sits in front of it, so the start budget is the sum.
TimeoutStartSec=6700
# Exit 75 (EX_TEMPFAIL) = flock gave up waiting for the long-runner lock
# (see Exec=). A clean, logged skip -- not a failure, not a page.
SuccessExitStatus=75
