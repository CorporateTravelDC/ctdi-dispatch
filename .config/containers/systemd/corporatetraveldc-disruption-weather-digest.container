[Unit]
Description=Corporate Travel DC -- flight/train/maritime disruption + weather-vs-facility digest (2026-08-09/10 catch-up session)

[Container]
Memory=768m
PodmanArgs=--memory-swap=768m
Image=localhost/corporatetraveldc-poller:latest
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
# Same Nextcloud-via-nginx-vhost reasoning as corporatetraveldc-transport-pattern-digest.container --
# host.containers.internal cannot reach the loopback-only WebDAV port directly.
# See docs/COMPLIANCE_SECURITY.md, "Container Network Isolation".
Network=pasta:--map-gw
Environment=NEXTCLOUD_WEBDAV_BASE=http://host.containers.internal:80/remote.php/dav/files
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
Exec=scripts/verified-exec.sh python3 src/poller/skills/disruption_weather_digest.py

[Service]
Slice=production.slice
MemoryLow=256M
Type=oneshot
# Phase 4 2026-08-15 (plan joyful-mapping-crown): reconciled with the
# skill's spike-measured Python timeouts (forced TIER2+ contention, same
# methodology as the Phase-3 53s baseline). Budget = 800s fixed
# (container start + generate() preflight gates 240+180 + load-phase
# allocation)
# + 810s digest call (max_retries=0) = 1610s -> 1700. A governor-pause retry-wait can still exceed this;
# systemd remains the deliberate backstop.
# 2026-08-17 (fable sweep): 1700 -> 3000. The 800s fixed allowance does not
# survive real Ollama-queue contention: live kill today -- manual run
# 15:27:38 EDT spent ~16min in slot-wait/load before its generate call
# (preload POST completed 15:44:20), hit this ceiling at 15:55:58, and the
# narrative that COMPLETED during stop-sigterm (15:57:27, 'narrative
# generated via Ollama/...disruption-weather-digest') was SIGKILLed before
# the vault write -- a finished generation thrown away. New budget: 800s
# fixed + 810s call + ~1200s queue-wait allowance = 2810 -> 3000. The
# daily-watch timer-grid fix in this same change removes most of the
# convergence that caused the wait.
TimeoutStartSec=3000
