# ~/.config/containers/systemd/openwebui.container
#
# OpenWebUI -- browser-based Ollama chat UI
#
# Access:
#   Tailscale: http://100.x.x.x:3000
#   CF tunnel: https://openwebui.example.com
#
# Ollama backend: http://100.x.x.x:11434 -- this host's own Tailscale
# IP, not host.containers.internal. Ollama binds that IP specifically, not
# 127.0.0.1 (see install/ollama/install-ollama.sh) -- pasta's --map-gw
# cannot reach a strictly loopback-bound service at all (kernel-level
# anti-spoofing, not a Podman limitation), so the host.containers.internal
# alias was never going to work here regardless of --map-gw. No
# Network=pasta:--map-gw needed on this container: 100.x.x.x is a real
# routable address reachable via normal pasta outbound NAT, the same way
# corporatetraveldc-runner.container reaches its own dependencies.

[Unit]
Description=OpenWebUI -- Ollama browser interface
After=ollama.service network-online.target
Wants=network-online.target

[Container]
Memory=1536m
# No additional swap beyond the RAM cap -- forces a clean OOM-kill
# instead of swap-thrashing (zram) if a container leaks past Memory=.
PodmanArgs=--memory-swap=1536m
Image=ghcr.io/open-webui/open-webui:main
ContainerName=openwebui
AutoUpdate=registry
PublishPort=3000:8080
Volume=/var/lib/openwebui:/app/backend/data:Z
Environment=OLLAMA_BASE_URL=http://100.x.x.x:11434
NoNewPrivileges=true

[Service]
# Proportional CPU share, not a hard pin -- kernel scheduler enforces
# live, every tick. Only matters when something else (notably Ollama,
# CPUWeight=500) is actually contending for CPU right now; an idle box
# still lets this container burst across all cores for free.
CPUWeight=100
# Hard ceiling regardless of contention -- never more than 3 of the
# Pi's 4 cores for this container alone. See CLAUDE.md "Container
# resource limits".
CPUQuota=300%
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
# 2026-07-28: no longer auto-started at login. This unit and 17 others
# used to fire simultaneously via WantedBy=default.target the instant
# network-online.target was reached -- a boot-storm RAM/CPU/bandwidth
# risk, the same class of bug already fixed on the SWIM ingest side
# (see corporatetraveldc-ingest-itws.container). Startup is now owned by
# corporatetraveldc-stack-boot-stagger.service, which staggers all 18 via
# scripts/stack-boot-ctl.sh in a dependency-aware order, before the
# existing corporatetraveldc-boot-stagger.service staggers in the seven
# SWIM ingest units.
# No WantedBy here on purpose -- do not re-add without re-introducing
# the boot storm.
