# corporatetraveldc-demo-api.container
# Quadlet -- ~/.config/containers/systemd/ under corporatetraveldc
# Manage: systemctl --user {start,stop,status,restart} corporatetraveldc-demo-api
#
# Read-only playback API over the sovereign demo-source file (see
# src/demo/demo_api.py). Reuses the corporatetraveldc-demo image (recorder
# image already has fastapi/uvicorn via requirements.txt) with an Exec=
# override -- no separate Containerfile needed for a second process mode
# of the same image.
#
# Internal-only for now (127.0.0.1 + Tailscale IP, no PublishPort to a
# public interface, no nginx vhost, no Cloudflare Tunnel ingress rule).
# Standing up a public-facing demo requires a deliberate go-ahead --
# flagged separately, not wired here.
#
# 2026-08-14: mount narrowed as part of closing F6 (redteam pentest
# finding -- demo/production isolation was logical, not physical). This
# container used to mount the ENTIRE live /var/lib/corporatetraveldc tree,
# read-write (no :ro), even though the app code only ever opened it
# mode=ro at the SQLite URI level -- an app-level convention, not an
# OS-enforced boundary. A fully compromised demo-api process (a lower-
# trust, public-surface-by-design component) held real read-write mount
# permissions on the live production DB. Now: two narrow mounts, the
# sovereign demo-source directory read-only and the demo-state directory
# (profiles/passwords, already fully independent of live data)
# read-write for its own admin writes. This container has ZERO filesystem
# path to /var/lib/corporatetraveldc at all anymore -- not an app-level
# choice not to read it, no path to it exists.
# See docs/DEMO_DATA_ISOLATION_PLAN_2026-08-13.md Phase 4.

[Unit]
Description=Corporate Travel DC -- demo playback API (port 8004, read-only over sovereign demo-source)
After=network-online.target corporatetraveldc-demo.service
Wants=corporatetraveldc-demo.service

[Container]
Memory=512m
PodmanArgs=--memory-swap=512m
Image=localhost/corporatetraveldc-demo:latest
Exec=scripts/verified-exec.sh uvicorn demo.demo_api:app --host 0.0.0.0 --port 8004
PublishPort=127.0.0.1:8004:8004
PublishPort=100.x.x.x:8004:8004
Volume=/var/lib/corporatetraveldc-demo-source:/var/lib/corporatetraveldc-demo-source:ro,z
Volume=/var/lib/corporatetraveldc-demo-state:/var/lib/corporatetraveldc-demo-state:z
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
# 2026-08-26 fix (Opus blind review C-22 follow-up): DEMO_SESSION_SECRET
# lives here, scoped ONLY to the two public-demo containers -- never load
# the full dispatch-secrets.env into a public-facing container. See
# demo-secrets.env's own header comment for the convention this
# establishes for future role-specific demos (EA, travel-agent, etc.).
EnvironmentFile=/etc/corporatetraveldc/demo-secrets.env
AutoUpdate=local

[Service]
# 2026-08-06: dedicated slice, separate from app.slice (where the
# interactive desktop session -- Brave/Claude Desktop -- lives). Lets
# app.slice carry its own memory ceiling without also capping
# production. See .config/systemd/user/production.slice and
# .config/systemd/user/app.slice.d/50-desktop-memory-ceiling.conf.
Slice=production.slice
# MemoryLow (2026-08-06): protects roughly a third of this container's
# own Memory= cap from kernel reclaim as long as memory is available
# elsewhere on the box -- prioritizes production over an unconstrained
# desktop session under real memory pressure, not just a cap after the
# fact. Previously 0 (unset) everywhere, including ollama.service.
MemoryLow=170M
CPUWeight=100
CPUQuota=100%
Restart=always
RestartSec=5
TimeoutStartSec=30

[Install]
# 2026-07-28: no longer auto-started at login. This unit and 17 others
# used to fire simultaneously via WantedBy=default.target the instant
# network-online.target was reached -- a boot-storm RAM/CPU/bandwidth
# risk, the same class of bug already fixed on the SWIM ingest side
# (see corporatetraveldc-ingest-itws.container). Startup is now owned by
# corporatetraveldc-stack-boot-stagger.service, which staggers all 18 via
# scripts/stack-boot-ctl.sh in a dependency-aware order, before the
# existing corporatetraveldc-boot-stagger.service staggers in the seven
# SWIM ingest units.
# No WantedBy here on purpose -- do not re-add without re-introducing
# the boot storm.
