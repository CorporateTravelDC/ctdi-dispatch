# corporatetraveldc-demo-api.container
# Quadlet -- ~/.config/containers/systemd/ under corporatetraveldc
# Manage: systemctl --user {start,stop,status,restart} corporatetraveldc-demo-api
#
# Read-only playback API over demo.db (see src/demo/demo_api.py). Reuses
# the corporatetraveldc-demo image (recorder image already has fastapi/
# uvicorn via requirements.txt) with an Exec= override -- no separate
# Containerfile needed for a second process mode of the same image.
#
# Internal-only for now (127.0.0.1 + Tailscale IP, no PublishPort to a
# public interface, no nginx vhost, no Cloudflare Tunnel ingress rule).
# Standing up a public-facing demo requires a deliberate go-ahead --
# flagged separately, not wired here.

[Unit]
Description=Corporate Travel DC -- demo playback API (port 8004, read-only over demo.db)
After=network-online.target corporatetraveldc-demo.service
Wants=corporatetraveldc-demo.service

[Container]
Memory=512m
PodmanArgs=--memory-swap=512m
Image=localhost/corporatetraveldc-demo:latest
Exec=uvicorn demo.demo_api:app --host 0.0.0.0 --port 8004
PublishPort=127.0.0.1:8004:8004
PublishPort=100.x.x.x:8004:8004
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
AutoUpdate=local

[Service]
CPUWeight=100
CPUQuota=100%
Restart=always
RestartSec=5
TimeoutStartSec=30

[Install]
# 2026-07-28: no longer auto-started at login. This unit and 17 others
# used to fire simultaneously via WantedBy=default.target the instant
# network-online.target was reached -- a boot-storm RAM/CPU/bandwidth
# risk, the same class of bug already fixed on the SWIM ingest side
# (see corporatetraveldc-ingest-itws.container). Startup is now owned by
# corporatetraveldc-stack-boot-stagger.service, which staggers all 18 via
# scripts/stack-boot-ctl.sh in a dependency-aware order, before the
# existing corporatetraveldc-boot-stagger.service staggers in the seven
# SWIM ingest units.
# No WantedBy here on purpose -- do not re-add without re-introducing
# the boot storm.
