# corporatetraveldc-runner.container
# Quadlet -- ~/.config/containers/systemd/ under corporatetraveldc
# Manage: systemctl --user {start,stop,status,restart} corporatetraveldc-runner
#
# Default (pasta) networking, not Network=host: this container previously
# ran with full host networking, undocumented, with these PublishPort=
# lines already present but inert under it. Removed 2026-07-10 -- the
# scoped PublishPort= pattern below (matching corporatetraveldc-web.container)
# covers the same access, and DISPATCH_BASE_URL/ULTRAFEEDER_URL already
# address the host by its literal Tailscale IP, which pasta routes
# correctly without needing Network=pasta:--map-gw (that's only required
# for the host.containers.internal alias, not for reaching a real
# host-network-visible address directly).

[Unit]
Description=Corporate Travel DC -- dispatch-runner PWA (port 8001)
After=network-online.target
After=podman-user-wait-network-online.service
After=corporatetraveldc-web.service
Wants=corporatetraveldc-web.service

[Container]
Memory=1536m
# No additional swap beyond the RAM cap -- forces a clean OOM-kill
# instead of swap-thrashing (zram) if a container leaks past Memory=.
PodmanArgs=--memory-swap=1536m
Image=localhost/corporatetraveldc-runner:latest
PublishPort=127.0.0.1:8001:8001
PublishPort=100.x.x.x:8001:8001
Environment=DISPATCH_BASE_URL=http://100.x.x.x:8000
Environment=ULTRAFEEDER_URL=http://100.x.x.x:8080/data/aircraft.json
# 2026-08-27: main.py's own default (http://127.0.0.1:9081) has never
# actually worked under this container's pasta networking -- confirmed
# live, "connection refused" -- same class of issue ULTRAFEEDER_URL above
# was already overridden for. Never caught because acarshub's VDL2/ACARS
# path falls back to airplanes.live when the local fetch fails (see
# runner/main.py's "local acarshub first" comment), so the symptom was
# just "always uses the fallback," not an outright error. Fixed the same
# way, alongside the Opus blind review C-2 tailnet lockdown that moved
# acarshub's web port to 100.x.x.x:8092.
Environment=ACARSHUB_URL=http://100.x.x.x:8092
Environment=SSE_INTERVAL_SEC=30
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
AutoUpdate=local
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z

[Service]
# 2026-08-06: dedicated slice, separate from app.slice (where the
# interactive desktop session -- Brave/Claude Desktop -- lives). Lets
# app.slice carry its own memory ceiling without also capping
# production. See .config/systemd/user/production.slice and
# .config/systemd/user/app.slice.d/50-desktop-memory-ceiling.conf.
Slice=production.slice
# MemoryLow (2026-08-06): protects roughly a third of this container's
# own Memory= cap from kernel reclaim as long as memory is available
# elsewhere on the box -- prioritizes production over an unconstrained
# desktop session under real memory pressure, not just a cap after the
# fact. Previously 0 (unset) everywhere, including ollama.service.
MemoryLow=512M
# Proportional CPU share, not a hard pin -- kernel scheduler enforces
# live, every tick. Only matters when something else (notably Ollama,
# CPUWeight=500) is actually contending for CPU right now; an idle box
# still lets this container burst across all cores for free.
CPUWeight=100
# Hard ceiling regardless of contention -- never more than 3 of the
# Pi's 4 cores for this container alone. See CLAUDE.md "Container
# resource limits".
CPUQuota=300%
Restart=always
RestartSec=5
ExecStartPre=/bin/mkdir -p /run/corporatetraveldc

[Install]
# 2026-07-28: no longer auto-started at login. This unit and 17 others
# used to fire simultaneously via WantedBy=default.target the instant
# network-online.target was reached -- a boot-storm RAM/CPU/bandwidth
# risk, the same class of bug already fixed on the SWIM ingest side
# (see corporatetraveldc-ingest-itws.container). Startup is now owned by
# corporatetraveldc-stack-boot-stagger.service, which staggers all 18 via
# scripts/stack-boot-ctl.sh in a dependency-aware order, before the
# existing corporatetraveldc-boot-stagger.service staggers in the seven
# SWIM ingest units.
# No WantedBy here on purpose -- do not re-add without re-introducing
# the boot storm.
