# Executive Standard gate verifier — nginx auth_request brain, DB-backed.
# Reuses the poller image (psycopg + pgsql socket already present); publishes
# ONLY on 127.0.0.1 so nothing but local nginx can reach it. Reads the opaque
# token against exec_standard_tokens live -> revoke/expire/disable are instant.
[Unit]
Description=Corporate Travel DC -- Executive Standard access-gate verifier (auth_request)

[Container]
Image=localhost/corporatetraveldc-poller:latest
Environment=CORPORATETRAVELDC_UNIT=%N VERIFY_PORT=8787
Volume=corporatetraveldc-pgsql-sock:/var/run/postgresql
Volume=/opt/corporatetraveldc/private/executivestandard-website/verifier/verify.py:/opt/es-verify.py:ro,z
PublishPort=127.0.0.1:8787:8787
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
# 2026-10-04 (duel M9 pilot): only the secrets this service reads, not the whole
# dispatch-secrets.env -- generated by scripts/service-env/generate.py from
# scripts/service-env/execstandard-verifier.allowlist (DISPATCH_PG_PASSWORD).
EnvironmentFile=/etc/corporatetraveldc/svc/execstandard-verifier.env
Exec=python3 /opt/es-verify.py

[Service]
Slice=production.slice
Restart=always
MemoryMax=256M

[Install]
WantedBy=default.target
