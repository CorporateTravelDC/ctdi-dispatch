[Unit]
Description=Corporate Travel DC -- daily gig-economy/platform-labor watch

[Container]
# Same tier as aviation-daily-watch -- same model/call shape, 1-day
# lookback, no status block. Paired Memory=/--memory-swap= (equal
# values, zero extra swap) so a runaway here gets a clean OOM-kill
# instead of swap-thrashing the whole box.
Memory=768m
PodmanArgs=--memory-swap=768m
Image=localhost/corporatetraveldc-poller:latest
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
# Same scoped opt-in as the other daily-watch containers -- reaches
# Nextcloud WebDAV via the existing cloud.example.com nginx
# vhost through the internal alias, not host networking.
Network=pasta:--map-gw
Environment=NEXTCLOUD_WEBDAV_BASE=http://host.containers.internal:80/remote.php/dav/files
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
Exec=python3 poller/skills/gig_economy_daily_watch.py

[Service]
Slice=production.slice
MemoryLow=256M
Type=oneshot
TimeoutStartSec=950
