[Unit]
Description=Corporate Travel DC -- belt-and-suspenders pull-path connectivity/validity probe of every PULL-capable feed source

[Container]
Memory=256m
PodmanArgs=--memory-swap=256m
Image=localhost/corporatetraveldc-poller:latest
Environment=CORPORATETRAVELDC_UNIT=%N
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
Volume=corporatetraveldc-pgsql-sock:/var/run/postgresql
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
Exec=scripts/verified-exec.sh python3 src/poller/skills/pull_path_verify.py

[Service]
Slice=production.slice
MemoryLow=85M
Type=oneshot
TimeoutStartSec=180

[Install]
WantedBy=default.target
