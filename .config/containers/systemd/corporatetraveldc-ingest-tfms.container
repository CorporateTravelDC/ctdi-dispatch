# corporatetraveldc-ingest-tfms.container
# Install to ~/.config/containers/systemd/ under corporatetraveldc
# Manage: systemctl --user {start,stop,status,restart} corporatetraveldc-ingest-tfms
#
# Part of the 2026-07-26 ingest split: one process/container per SWIM feed
# (plus one "core" container for NWWS-OI/Amtrak/local_airspace) instead of
# all of it as threads inside a single corporatetraveldc-ingest container.
# Same image as before (localhost/corporatetraveldc-ingest:latest) -- the
# split is entirely env-var driven (SWIM_NMS_ENABLED, SWIM_NMS_SKIP_FEEDS,
# NWWS_ENABLED, AMTRAK_ENABLED, LOCAL_AIRSPACE_ENABLED), no code duplication.
# See scripts/ingest-feed-ctl.sh for stop/start/restart-with-stagger control
# across all seven at once, and docs/DATA_SOURCES.md for the rationale
# (CPU/memory contention across 6 concurrent Solace sessions was implicated
# in the SWIM keep-alive churn and poller fetch-cadence drift found the
# same night).
[Unit]
Description=Corporate Travel DC ingest -- SWIM TFMS only
After=network-online.target
After=ntfy.service
Wants=ntfy.service

[Container]
Memory=320m
PodmanArgs=--memory-swap=320m
Image=localhost/corporatetraveldc-ingest:latest
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
Volume=/opt/corporatetraveldc/watchlists:/opt/corporatetraveldc/watchlists:ro,z
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
Environment=SWIM_NMS_ENABLED=true
Environment=SWIM_NMS_SKIP_FEEDS=fdps,stdds,fns,tbfm,itws
Environment=NWWS_ENABLED=false
Environment=AMTRAK_ENABLED=false
Environment=LOCAL_AIRSPACE_ENABLED=false
AutoUpdate=local

[Service]
# 2026-08-06: dedicated slice, separate from app.slice (where the
# interactive desktop session -- Brave/Claude Desktop -- lives). Lets
# app.slice carry its own memory ceiling without also capping
# production. See .config/systemd/user/production.slice and
# .config/systemd/user/app.slice.d/50-desktop-memory-ceiling.conf.
Slice=production.slice
# MemoryLow (2026-08-06): protects roughly a third of this container's
# own Memory= cap from kernel reclaim as long as memory is available
# elsewhere on the box -- prioritizes production over an unconstrained
# desktop session under real memory pressure, not just a cap after the
# fact. Previously 0 (unset) everywhere, including ollama.service.
MemoryLow=106M
# 2026-08-14: dropped from the proportional-share default (100) to 30 --
# a post-reboot SWIM catch-up burst (5 concurrent ingest.main processes)
# stacked with a demo backfill job pushed load average to ~6 on this
# 4-core box, starving a production ops-brief generation into a 500/
# timeout and visibly slowing DNS. Still proportional, not a hard cap --
# these still get full CPU on an otherwise-idle box, this only makes them
# yield sooner when something else actually wants the core.
CPUWeight=30
CPUQuota=90%
Restart=always
RestartSec=15
TimeoutStartSec=30

[Install]
WantedBy=default.target
