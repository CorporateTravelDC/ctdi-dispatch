[Unit]
Description=Corporate Travel DC -- daily rolling ingest of demo-archiver recorder data into second brain

[Container]
# 2026-10-27: 1g -> 1536m (OOM-killed again at the 1G cap, 04:15 ET 10-27; operator: 1.5 GB after the migration).
# 2026-10-26: 512m -> 1g. Two kernel OOM kills inside the 512m cap at a 548 MB peak (04:15 ET
# scheduled run and a manual rerun with 6.2 GB free on the box): the rolling archive outgrew it.
Memory=1536m
# 2026-08-06: previously unguarded -- daily archival pass, no heavy LLM narrative -- lightest tier.
# Paired Memory=/--memory-swap= (equal values, zero extra swap) so a
# runaway here gets a clean OOM-kill instead of swap-thrashing the
# whole box -- same pattern as every other production container.
PodmanArgs=--memory-swap=1536m
Image=localhost/corporatetraveldc-poller:latest
Environment=CORPORATETRAVELDC_UNIT=%N
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
Volume=corporatetraveldc-pgsql-sock:/var/run/postgresql
# Same WebDAV reach pattern as the other second-brain Quadlets -- see
# docs/COMPLIANCE_SECURITY.md, "Container Network Isolation". Reads
# demo.db directly off the shared volume (no network needed for that
# part); the pasta opt-in here is only for the vault write.
Network=pasta:--map-gw
Environment=NEXTCLOUD_WEBDAV_BASE=http://host.containers.internal:80/remote.php/dav/files
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
# 2026-10-05 (duel M9, U7 rollout): only the secret NAMES the poller image reads
# (scripts/service-env/poller.allowlist -> generate.py --write), not dispatch-secrets.env
EnvironmentFile=/etc/corporatetraveldc/svc/poller.env
Exec=scripts/verified-exec.sh python3 src/poller/skills/second_brain_demo_archiver_daily.py

[Service]
# 2026-08-06: dedicated slice, separate from app.slice (where the
# interactive desktop session -- Brave/Claude Desktop -- lives). Lets
# app.slice carry its own memory ceiling without also capping
# production. See .config/systemd/user/production.slice and
# .config/systemd/user/app.slice.d/50-desktop-memory-ceiling.conf.
Slice=production.slice
# MemoryLow (2026-08-06): protects roughly a third of this container's
# own Memory= cap from kernel reclaim as long as memory is available
# elsewhere on the box -- prioritizes production over an unconstrained
# desktop session under real memory pressure, not just a cap after the
# fact. Previously 0 (unset) everywhere, including ollama.service.
MemoryLow=170M
Type=oneshot
TimeoutStartSec=120
