[Unit]
Description=Corporate Travel DC -- entity-tracking findings digest (consolidated surface into second brain)

[Container]
Memory=384m
PodmanArgs=--memory-swap=384m
Image=localhost/corporatetraveldc-poller:latest
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
Network=pasta:--map-gw
Environment=NEXTCLOUD_WEBDAV_BASE=http://host.containers.internal:80/remote.php/dav/files
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
Exec=scripts/verified-exec.sh python3 src/poller/skills/entity_tracking_digest.py

[Service]
Slice=production.slice
MemoryLow=128M
Type=oneshot
# No Ollama call in this skill (pure DB query + vault write) -- a few
# seconds normally, generous margin for a slow WebDAV write. Not budgeted
# like the Ollama-calling daily-watch skills (compare trains-yachts'
# 7000s TimeoutStartSec, which accounts for preflight gates + retries).
TimeoutStartSec=300
