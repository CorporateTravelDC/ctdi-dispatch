[Unit]
Description=Corporate Travel DC -- convective SIGMET polygon archiver (builds the weather-attribution history Detector D is blocked on)

[Container]
Memory=256m
PodmanArgs=--memory-swap=256m
Image=localhost/corporatetraveldc-poller:latest
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
Exec=scripts/verified-exec.sh python3 src/poller/skills/convective_sigmet_archiver.py

[Service]
Slice=production.slice
MemoryLow=85M
Type=oneshot
TimeoutStartSec=120
