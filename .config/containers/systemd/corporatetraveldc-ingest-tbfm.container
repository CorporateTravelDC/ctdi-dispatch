# corporatetraveldc-ingest-tbfm.container
# Install to ~/.config/containers/systemd/ under corporatetraveldc
# Manage: systemctl --user {start,stop,status,restart} corporatetraveldc-ingest-tbfm
#
# Part of the 2026-07-26 ingest split: one process/container per SWIM feed
# (plus one "core" container for NWWS-OI/Amtrak/local_airspace) instead of
# all of it as threads inside a single corporatetraveldc-ingest container.
# Same image as before (localhost/corporatetraveldc-ingest:latest) -- the
# split is entirely env-var driven (SWIM_NMS_ENABLED, SWIM_NMS_SKIP_FEEDS,
# NWWS_ENABLED, AMTRAK_ENABLED, LOCAL_AIRSPACE_ENABLED), no code duplication.
# See scripts/ingest-feed-ctl.sh for stop/start/restart-with-stagger control
# across all seven at once, and docs/DATA_SOURCES.md for the rationale
# (CPU/memory contention across 6 concurrent Solace sessions was implicated
# in the SWIM keep-alive churn and poller fetch-cadence drift found the
# same night).
[Unit]
Description=Corporate Travel DC ingest -- SWIM TBFM only
After=network-online.target
After=ntfy.service
Wants=ntfy.service

[Container]
Memory=320m
PodmanArgs=--memory-swap=320m
Image=localhost/corporatetraveldc-ingest:latest
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
Volume=/opt/corporatetraveldc/watchlists:/opt/corporatetraveldc/watchlists:ro,z
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
Environment=SWIM_NMS_ENABLED=true
Environment=SWIM_NMS_SKIP_FEEDS=fdps,stdds,tfms,fns,itws
Environment=NWWS_ENABLED=false
Environment=AMTRAK_ENABLED=false
Environment=LOCAL_AIRSPACE_ENABLED=false
AutoUpdate=local

[Service]
# 2026-08-06: dedicated slice, separate from app.slice (where the
# interactive desktop session -- Brave/Claude Desktop -- lives). Lets
# app.slice carry its own memory ceiling without also capping
# production. See .config/systemd/user/production.slice and
# .config/systemd/user/app.slice.d/50-desktop-memory-ceiling.conf.
Slice=production.slice
# MemoryLow (2026-08-06): protects roughly a third of this container's
# own Memory= cap from kernel reclaim as long as memory is available
# elsewhere on the box -- prioritizes production over an unconstrained
# desktop session under real memory pressure, not just a cap after the
# fact. Previously 0 (unset) everywhere, including ollama.service.
MemoryLow=106M
# 2026-08-14: dropped from the proportional-share default (100) to 30 --
# a post-reboot SWIM catch-up burst (5 concurrent ingest.main processes)
# stacked with a demo backfill job pushed load average to ~6 on this
# 4-core box, starving a production ops-brief generation into a 500/
# timeout and visibly slowing DNS. Still proportional, not a hard cap --
# these still get full CPU on an otherwise-idle box, this only makes them
# yield sooner when something else actually wants the core.
# 2026-08-30: raised 30 -> 5030 (operator directive). The 2026-08-14
# incident above was never actually about Ollama contention (that
# reasoning lived in thermal-ingest-guard.py's now-removed
# "Ollama-contention" trigger, a separate, already-fixed false lead) --
# it was a real SWIM-catch-up-burst-vs-ops-brief contention event. But
# the retired ollama.service's own CPUWeight tier (5000, see the deleted
# ollama.service.d/20-resource-limits.conf) is now unclaimed: llama-hot/
# chat are statically resident processes with no on-demand cold-load CPU
# spike to protect against (unlike Ollama's old per-call model-swap
# behavior), so there is no longer a real contention pattern between
# SWIM ingest and local LLM inference to defend against by keeping
# ingest this low. New value is simply old(30) + Ollama's old
# weight(5000) = 5000 (2026-08-30, refined same day: dropped the +30 remainder --
# it carried no meaning once the jump itself is the point; flat 5000
# reads as exactly what it is, "Ollama's old priority, full stop."), well under the 9000 must-never-die tier
# (ntfy/cloudflared/llama-hot/chat) -- still proportional-share, not a
# hard cap, and this feed's own CPUQuota below is unchanged.
# 2026-09-01 (operator directive): raised 5000 -> 9500 -- above the
# 9000 "must-never-die" tier this was deliberately kept under. That
# earlier reasoning assumed no real contention with local LLM inference;
# live investigation today found llama-chat (CPUWeight=9000, sustained
# 150%+ CPU) directly correlated with SWIM Solace keep-alive-failure
# bursts (FDPS/TBFM/TFMS/STDDS/ITWS all flapping ~1/13s), which silently
# dropped OOOI coverage for at least one live flight. SWIM ingest now
# outranks everything else on this box, deliberately -- see
# scripts/swim-session-health-watch.sh for the alerting side of this fix.
#
# 2026-09-03 (operator directive, dialed back): 9500 traded the
# keep-alive problem for a worse one. Live investigation found llama-chat
# (CPUWeight=9000) is the SHARED single-slot server for basically the
# entire report/chat-tier skill fleet (common/llm.py routes every
# num_ctx<=4096 persona here) -- ranking all 7 SWIM feeds above it meant
# llama-chat systematically lost every contention round, crawled at
# ~1.2-1.3 tok/s, and the resulting request backlog inflated system load
# average past the thermal-ingest-guard's LOCKDOWN threshold (>=40) 17
# times in 36h -- each trip shedding the ENTIRE stack (all 6 SWIM feeds +
# ingest-core + poller/pusher/runner), which is strictly worse for SWIM
# fidelity than the keep-alive flapping this was meant to fix. New value
# 7500 -- still meaningfully above the original 5000 baseline (keeps some
# real protection against keep-alive drops) but below llama-chat's 9000,
# so SWIM always gets real CPU share without categorically starving the
# report/chat tier. Operator-accepted tradeoff: a delayed/slowed brief
# under contention is fine; the SWIM feeds must always run.
CPUWeight=7500
# 2026-08-30: raised (operator directive) -- this feed is one of the
# three real OOOI-correlation sources (see common/db.py's
# _OOOI_SOURCE_PRIORITY: tbfm/tfms/smes -- smes lives in this STDDS
# handler alongside tbfm/tfms themselves), unlike fdps/itws/notam/core.
# Modest +20-point bump, not a large jump -- relative ordering
# (stdds > tfms > tbfm) preserved, no live incident forcing more.
CPUQuota=100%
Restart=always
RestartSec=15
TimeoutStartSec=30

[Install]
WantedBy=default.target
