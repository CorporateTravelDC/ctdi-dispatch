[Unit]
Description=Corporate Travel DC -- transport pattern digest (codeshare/route-lock/drift mining across flights, trains, vessels + Phase 3 decay sweep, 2026-07-28)

[Container]
Memory=768m
# 2026-08-06: previously unguarded -- lighter LLM prompt, same shape as second-brain-daily (see OLLAMA_TIMEOUT=300 in transport_pattern_digest.py).
# Paired Memory=/--memory-swap= (equal values, zero extra swap) so a
# runaway here gets a clean OOM-kill instead of swap-thrashing the
# whole box -- same pattern as every other production container.
PodmanArgs=--memory-swap=768m
Image=localhost/corporatetraveldc-poller:latest
Environment=CORPORATETRAVELDC_UNIT=%N
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
Volume=corporatetraveldc-pgsql-sock:/var/run/postgresql
# Same Nextcloud-via-nginx-vhost reasoning as corporatetraveldc-second-brain-rss.container --
# host.containers.internal cannot reach the loopback-only WebDAV port directly, so this reaches
# it through the existing 0.0.0.0-bound nginx vhost for cloud.example.com instead.
# See docs/COMPLIANCE_SECURITY.md, "Container Network Isolation".
Network=pasta:--map-gw
Environment=NEXTCLOUD_WEBDAV_BASE=http://host.containers.internal:80/remote.php/dav/files
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
# 2026-09-06 LONG-RUNNER LOCK (operator directive: "No 2 long runners can run
# together either EVER"): flock on the box-wide unit lock wraps the whole
# run, so a second report container blocks here -- inside its own
# container, holding no model, no threads -- until the one ahead exits.
# It waits; it is never refused and never kills the run ahead of it.
# common/llama_pool.py takes a separate per-generation lock on top.
#
# 2026-09-22 -- BOUNDED WAIT. The lock discipline above is unchanged and
# non-negotiable; what changed is what happens when the wait runs too long.
#
# Root-caused today: this unit's 2026-09-22 00:53 failure was Result=timeout
# after 28min 12s wall against just 16.9s CPU -- a process asleep on flock,
# not a hung skill. Bare `flock` waits forever, TimeoutStartSec=1600 (26m40s)
# fires first, and systemd SIGKILLs it. That turns ordinary contention into a
# unit FAILURE, which fires OnFailure= and -- as happened today -- makes
# check-claude-md-drift.sh fail, which blocks manifest signing entirely.
#
# `-w 1200` (20min, comfortably inside the 1600s timeout) makes a busy box a
# clean SKIP instead: flock exits 1 having never started the skill, and the
# `||` branch converts that to exit 0 plus a log line. Nothing half-runs --
# the skill either holds the lock for its entire run or is never invoked.
#
# Same posture as maintenance-window-guard.sh's ExecCondition= (skip cleanly,
# never fail) and the same bounded wait local-llm-synthesize.sh already uses
# (`flock -w 300`). A skipped digest costs one cycle; a failed unit costs a
# page and a blocked signing gate.
Exec=/bin/sh -c 'flock -w 1200 /var/lib/corporatetraveldc/llama-pool/long-runner-unit.lock scripts/verified-exec.sh python3 src/poller/skills/transport_pattern_digest.py; rc=$?; [ "$rc" -eq 1 ] && { echo "transport-pattern-digest: long-runner lock still held after 1200s -- skipping this cycle (not a failure)"; exit 0; }; exit "$rc"'

[Service]
# 2026-09-21 maintenance window (operator directive): long report-tier
# jobs may only run 23:00-05:00 America/New_York, so they never contend
# with the latency-sensitive flight/weather alert path. ExecCondition=
# (NOT ExecStartPre=) so an out-of-window firing SKIPS cleanly instead of
# marking the unit failed and paging via OnFailure=. Bounds are
# configurable: CTDC_MAINTENANCE_WINDOW_START/_END in dispatch.env.
# WARNING: this unit's OnCalendar= MUST stay inside the window or it will
# silently never run again. Verify with:
#   scripts/maintenance-window-guard.sh --check --at HH:MM
ExecCondition=/opt/corporatetraveldc/private/ctdi-dispatch-internal/scripts/maintenance-window-guard.sh
# 2026-08-06: dedicated slice, separate from app.slice (where the
# interactive desktop session -- Brave/Claude Desktop -- lives). Lets
# app.slice carry its own memory ceiling without also capping
# production. See .config/systemd/user/production.slice and
# .config/systemd/user/app.slice.d/50-desktop-memory-ceiling.conf.
Slice=production.slice
# MemoryLow (2026-08-06): protects roughly a third of this container's
# own Memory= cap from kernel reclaim as long as memory is available
# elsewhere on the box -- prioritizes production over an unconstrained
# desktop session under real memory pressure, not just a cap after the
# fact. Previously 0 (unset) everywhere, including ollama.service.
MemoryLow=256M
Type=oneshot
# Phase 4 2026-08-15 (plan joyful-mapping-crown): reconciled with the
# skill's spike-measured Python timeouts (forced TIER2+ contention, same
# methodology as the Phase-3 53s baseline). Budget = 800s fixed
# (container start + generate() preflight gates 240+180 + load-phase
# allocation)
# + 600s digest call (max_retries=0) = 1400s exact sum. 2026-08-16:
# independent validation flagged this as the one unit with zero cushion
# above its own formula -- every other reconciled unit carries some
# margin, this one didn't. +200s (~14%) added; a governor-pause
# retry-wait can still exceed this, systemd remains the deliberate
# backstop either way.
TimeoutStartSec=1600
