[Unit]
Description=Corporate Travel DC -- second-brain knowledge-graph (graph.json/vault-graph.html) recompile

[Container]
Memory=512m
PodmanArgs=--memory-swap=512m
Image=localhost/corporatetraveldc-poller:latest
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
# 2026-08-12: also write to the shared data volume (see build_graph.py's
# own comment on the live-served copy) -- no special networking needed
# for that part, just the default bridge is enough for local volume I/O.
# Network=pasta:--map-gw was tried during this unit's first wiring
# (2026-09-03) to route WebDAV through host.containers.internal, but
# turned out unnecessary -- see build_graph.py's enumerate_vault() for
# the real fix (a missing trailing slash was causing an nginx redirect
# regardless of which host/port the request arrived on). Default
# networking + dispatch.env's normal public NEXTCLOUD_WEBDAV_BASE works
# fine once that's fixed, same as this script's original by-hand usage.
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
Exec=scripts/verified-exec.sh python3 -m second_brain.knowledge_graph.build_graph

[Service]
Slice=production.slice
MemoryLow=128M
Type=oneshot
# 2026-09-03: build_graph.py fetches every curated markdown note in the
# vault over WebDAV (~9,600 docs at last count) before computing the graph
# -- real network I/O, not the near-instant local SQLite recompute
# semantic-compile-daily does. Generous timeout for that, same philosophy
# as other full-vault-scan skills.
TimeoutStartSec=1800
