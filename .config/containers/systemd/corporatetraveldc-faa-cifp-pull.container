[Unit]
Description=Corporate Travel DC -- weekly pull of the current FAA CIFP (Coded Instrument Flight Procedures) cycle file

[Container]
Memory=256m
PodmanArgs=--memory-swap=256m
Image=localhost/corporatetraveldc-poller:latest
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
Exec=scripts/verified-exec.sh python3 src/poller/skills/faa_cifp_pull.py

[Service]
Slice=production.slice
MemoryLow=85M
Type=oneshot
TimeoutStartSec=180

[Install]
WantedBy=default.target
