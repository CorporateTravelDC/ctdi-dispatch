[Unit]
Description=Corporate Travel DC -- weekly personal data export analysis (LinkedIn, Uber/Lyft later)

[Container]
# 2026-11-04 operator rule: anything that leaves this container or goes into another one
# uses 100.x.x.x, hard-set (ntfy runs in its own container). host.containers.internal
# does not resolve on default pasta networking (--no-map-gw): ingest pushes were lost.
Environment=NTFY_URL=http://100.x.x.x:2586
Memory=512m
PodmanArgs=--memory-swap=512m
Image=localhost/corporatetraveldc-poller:latest
Environment=CORPORATETRAVELDC_UNIT=%N
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
Volume=corporatetraveldc-pgsql-sock:/var/run/postgresql
Network=pasta:--map-gw
Environment=NEXTCLOUD_WEBDAV_BASE=http://100.x.x.x:80/remote.php/dav/files
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
# 2026-10-05 (duel M9, U7 rollout): only the secret NAMES the poller image reads
# (scripts/service-env/poller.allowlist -> generate.py --write), not dispatch-secrets.env
EnvironmentFile=/etc/corporatetraveldc/svc/poller.env
Exec=scripts/verified-exec.sh python3 src/poller/skills/personal_export_watch.py

[Service]
Slice=production.slice
MemoryLow=170M
Type=oneshot
# Phase 4 2026-08-15 (plan joyful-mapping-crown): reconciled with the
# skill's spike-measured Python timeouts (forced TIER2+ contention, same
# methodology as the Phase-3 53s baseline). Budget = 800s fixed
# (container start + generate() preflight gates 240+180 + load-phase
# allocation)
# + 1740s entity extraction + 2 x 150s domain guesses = 2840s -> 2900. A governor-pause retry-wait can still exceed this;
# systemd remains the deliberate backstop.
TimeoutStartSec=2900
