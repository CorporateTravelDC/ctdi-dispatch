[Unit]
Description=Corporate Travel DC - dumpvdl2 VDL2 decoder
After=network-online.target
After=corporatetraveldc-acarsrouter.service
Wants=corporatetraveldc-acarsrouter.service

[Container]
Memory=1536m
# No additional swap beyond the RAM cap -- forces a clean OOM-kill
# instead of swap-thrashing (zram) if a container leaks past Memory=.
PodmanArgs=--memory-swap=1536m
Image=ghcr.io/sdr-enthusiasts/docker-dumpvdl2:latest
ContainerName=corporatetraveldc-dumpvdl2
# CORRECTED 2026-08-26 (Opus blind review H-7): this was the older, looser
# whole-USB-bus-read-write + UserNS=host + SecurityLabelDisable=true
# passthrough -- confirmed live via /proc/<pid>/attr/current showing
# spc_t (SELinux-unconfined) vs container_t everywhere else, the one SDR
# container the 2026-08-03 hardening pass (see corporatetraveldc-ultrafeeder
# .container's own history) skipped, despite that pass's own comment
# incorrectly claiming both dumpvdl2 and ultrafeeder already agreed on the
# scoped pattern. The udev rule for this exact dongle (serial ACARS0130 ->
# /dev/rtl_sdr_acars) already existed and was simply never wired in.
AddDevice=/dev/rtl_sdr_acars:/dev/rtl_sdr_acars
Volume=/dev/bus/usb:/dev/bus/usb:ro
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
# 2026-08-26 (Opus blind review C-4): dispatch-secrets.env intentionally
# NOT loaded here -- third-party code parsing untrusted RF input, never
# referenced any value from that file, used to get the full ~95-key
# secrets set for nothing it actually uses.
Environment=TZ=America/New_York
Environment=RTL_SERIAL=ACARS0130
Environment=FEED_ID=corporatetraveldc-kdca-vdl2
Environment=FREQUENCIES=136.650;136.800;136.900;136.925;136.975
Environment=GAIN=40
Environment=ZMQ_MODE=server
Environment=ZMQ_ENDPOINT=tcp://0.0.0.0:45555
Environment=VDLM_FILTER_ENABLE=TRUE
Network=acars-net.network
AutoUpdate=registry

[Service]
# 2026-08-06: dedicated slice, separate from app.slice (where the
# interactive desktop session -- Brave/Claude Desktop -- lives). Lets
# app.slice carry its own memory ceiling without also capping
# production. See .config/systemd/user/production.slice and
# .config/systemd/user/app.slice.d/50-desktop-memory-ceiling.conf.
Slice=production.slice
# MemoryLow (2026-08-06): protects roughly a third of this container's
# own Memory= cap from kernel reclaim as long as memory is available
# elsewhere on the box -- prioritizes production over an unconstrained
# desktop session under real memory pressure, not just a cap after the
# fact. Previously 0 (unset) everywhere, including ollama.service.
MemoryLow=512M
# Proportional CPU share, not a hard pin -- kernel scheduler enforces
# live, every tick. Only matters when something else (notably Ollama,
# CPUWeight=500) is actually contending for CPU right now; an idle box
# still lets this container burst across all cores for free.
CPUWeight=100
# Hard ceiling regardless of contention -- never more than 3 of the
# Pi's 4 cores for this container alone. See CLAUDE.md "Container
# resource limits".
CPUQuota=300%
Restart=always
RestartSec=30
TimeoutStartSec=60

[Install]
# 2026-07-28: no longer auto-started at login. This unit and 17 others
# used to fire simultaneously via WantedBy=default.target the instant
# network-online.target was reached -- a boot-storm RAM/CPU/bandwidth
# risk, the same class of bug already fixed on the SWIM ingest side
# (see corporatetraveldc-ingest-itws.container). Startup is now owned by
# corporatetraveldc-stack-boot-stagger.service, which staggers all 18 via
# scripts/stack-boot-ctl.sh in a dependency-aware order, before the
# existing corporatetraveldc-boot-stagger.service staggers in the seven
# SWIM ingest units.
# No WantedBy here on purpose -- do not re-add without re-introducing
# the boot storm.
