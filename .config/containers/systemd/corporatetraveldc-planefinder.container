[Unit]
Description=Corporate Travel DC - PlaneFinder feeder
After=network-online.target
After=corporatetraveldc-ultrafeeder.service
Wants=corporatetraveldc-ultrafeeder.service

[Container]
Memory=1536m
# No additional swap beyond the RAM cap -- forces a clean OOM-kill
# instead of swap-thrashing (zram) if a container leaks past Memory=.
PodmanArgs=--memory-swap=1536m
Image=ghcr.io/sdr-enthusiasts/docker-planefinder:latest
ContainerName=corporatetraveldc-planefinder
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
EnvironmentFile=/etc/corporatetraveldc/dispatch-secrets.env
Environment=BEASTHOST=host.containers.internal
Environment=BEASTPORT=30005
# SHARECODE / LAT / LONG / ALT come from dispatch-secrets.env
# (EnvironmentFile= above) -- never hardcoded here, see CLAUDE.md.
PublishPort=127.0.0.1:30053:30053
AutoUpdate=registry

[Service]
# Proportional CPU share, not a hard pin -- kernel scheduler enforces
# live, every tick. Only matters when something else (notably Ollama,
# CPUWeight=500) is actually contending for CPU right now; an idle box
# still lets this container burst across all cores for free.
CPUWeight=100
# Hard ceiling regardless of contention -- never more than 3 of the
# Pi's 4 cores for this container alone. See CLAUDE.md "Container
# resource limits".
CPUQuota=300%
Restart=always
RestartSec=30
TimeoutStartSec=60

[Install]
WantedBy=default.target
