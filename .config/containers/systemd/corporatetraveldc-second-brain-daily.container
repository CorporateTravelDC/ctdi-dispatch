[Unit]
Description=Corporate Travel DC -- second-brain daily digest into the Nextcloud vault

[Container]
Memory=768m
# 2026-08-06: previously unguarded -- lighter LLM prompt -- single day's content (see OLLAMA_TIMEOUT=300 in second_brain_daily.py).
# Paired Memory=/--memory-swap= (equal values, zero extra swap) so a
# runaway here gets a clean OOM-kill instead of swap-thrashing the
# whole box -- same pattern as every other production container.
PodmanArgs=--memory-swap=768m
Image=localhost/corporatetraveldc-poller:latest
Environment=CORPORATETRAVELDC_UNIT=%N
Volume=/var/lib/corporatetraveldc:/var/lib/corporatetraveldc:z
Volume=corporatetraveldc-pgsql-sock:/var/run/postgresql
# Nextcloud WebDAV (port 8090) is published on 127.0.0.1 only, by
# design (nginx-fronted) -- host.containers.internal cannot reach a
# strictly loopback-bound service under any pasta flag (see
# docs/COMPLIANCE_SECURITY.md, "Container Network Isolation"). Rather
# than widening Nextcloud's bind or granting this container the
# host's full network stack, reach Nextcloud through the *existing*
# nginx vhost for cloud.example.com, which already listens
# on 0.0.0.0:80 and proxies to 127.0.0.1:8090 -- the same sanctioned
# ingress real WebDAV clients use, just via the internal alias instead
# of the public path. That is a 0.0.0.0-bound host service, so the
# documented per-container opt-in applies: Network=pasta:--map-gw
# restores host.containers.internal for this container only (same
# pattern as corporatetraveldc-pusher.container reaching ntfy). No
# change to Nextcloud's publish scope, no host networking.
Network=pasta:--map-gw
Environment=NEXTCLOUD_WEBDAV_BASE=http://host.containers.internal:80/remote.php/dav/files
EnvironmentFile=/etc/corporatetraveldc/dispatch.env
# 2026-10-05 (duel M9, U7 rollout): only the secret NAMES the poller image reads
# (scripts/service-env/poller.allowlist -> generate.py --write), not dispatch-secrets.env
EnvironmentFile=/etc/corporatetraveldc/svc/poller.env
# 2026-09-06 LONG-RUNNER LOCK (operator directive: "No 2 long runners can run
# together either EVER"): flock on the box-wide unit lock wraps the whole
# run, so a second report container blocks here -- inside its own
# container, holding no model, no threads -- until the one ahead exits.
# It waits; it is never refused and never kills the run ahead of it.
# common/llama_pool.py takes a separate per-generation lock on top.
#
# 2026-10-03 ROOT CAUSE of the 23:45 -> 00:29:51 timeout kill (8s CPU over
# 44m53s wall, zero skill log lines): the wait above was UNBOUNDED and
# TimeoutStartSec counted it as run time. That night five long-runners
# queued on this one lock between 23:00 and 00:48 (concierge-travel held
# it 23:00-00:13, then ep-advance, ops-brief, transport-pattern -- each
# ~1h at load 19), so this unit never got the lock inside its 2600s
# budget and systemd SIGKILLed a process that had done nothing. Fix:
#   -w 3600  bound the queue wait to 1h, then give up instead of being
#            killed mid-queue;
#   -E 75    give-up exits EX_TEMPFAIL, declared a clean skip below
#            (SuccessExitStatus=75) -- the 2h sibling run retries, and
#            the journal carries flock's own "timeout while waiting to
#            get lock" line instead of a 'timeout' failure + page;
#   --verbose  logs how long the lock wait actually took on every run,
#            so queue depth is visible in the journal from now on.
# TimeoutStartSec below = 3600 (max queue wait) + 2600 (run budget) + 100.
Exec=/usr/bin/flock --verbose -w 3600 -E 75 /var/lib/corporatetraveldc/llama-pool/long-runner-unit.lock scripts/verified-exec.sh python3 src/poller/skills/second_brain_daily.py

[Service]
# 2026-09-21 maintenance window (operator directive): long report-tier
# jobs may only run 23:00-05:00 America/New_York, so they never contend
# with the latency-sensitive flight/weather alert path. ExecCondition=
# (NOT ExecStartPre=) so an out-of-window firing SKIPS cleanly instead of
# marking the unit failed and paging via OnFailure=. Bounds are
# configurable: CTDC_MAINTENANCE_WINDOW_START/_END in dispatch.env.
# WARNING: this unit's OnCalendar= MUST stay inside the window or it will
# silently never run again. Verify with:
#   scripts/maintenance-window-guard.sh --check --at HH:MM
ExecCondition=/opt/corporatetraveldc/private/ctdi-dispatch-internal/scripts/maintenance-window-guard.sh
# 2026-08-06: dedicated slice, separate from app.slice (where the
# interactive desktop session -- Brave/Claude Desktop -- lives). Lets
# app.slice carry its own memory ceiling without also capping
# production. See .config/systemd/user/production.slice and
# .config/systemd/user/app.slice.d/50-desktop-memory-ceiling.conf.
Slice=production.slice
# MemoryLow (2026-08-06): protects roughly a third of this container's
# own Memory= cap from kernel reclaim as long as memory is available
# elsewhere on the box -- prioritizes production over an unconstrained
# desktop session under real memory pressure, not just a cap after the
# fact. Previously 0 (unset) everywhere, including ollama.service.
MemoryLow=256M
Type=oneshot
# Phase 4 2026-08-15 (plan joyful-mapping-crown): reconciled with the
# skill's spike-measured Python timeouts (forced TIER2+ contention, same
# methodology as the Phase-3 53s baseline). Budget = 800s fixed
# (container start + generate() preflight gates 240+180 + load-phase
# allocation)
# + 2 attempts x 870s call (default max_retries=1) = 2540s -> 2600. A governor-pause retry-wait can still exceed this;
# systemd remains the deliberate backstop.
# 2026-10-03: 2600 was the RUN budget only; the lock queue wait (flock -w
# 3600 in Exec=) now sits in front of it, so the start budget is the sum.
# The 01:45 retry that night finished in 43m15s against a 43m20s budget
# -- the run budget itself is marginal at load 19, kept as-is here (the
# Phase-4 measured figure) but the queue wait is no longer eating it.
# Still < the timer's 120min OnUnitActiveSec, so firings cannot overlap.
TimeoutStartSec=6300
# Exit 75 (EX_TEMPFAIL) = flock gave up waiting for the long-runner lock
# (see Exec=). A clean, logged skip -- not a failure, not a page.
SuccessExitStatus=75

