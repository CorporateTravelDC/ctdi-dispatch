# security/signing.env -- live-only-in-spirit config for the signed-manifest
# integrity system (see docs/COMPLIANCE_SECURITY.md's "Signed Manifest
# Integrity" section, scripts/sign-manifest.sh, scripts/verify-manifest.sh).
#
# This is the OPERATOR'S OWN key fingerprint for THIS deployment -- same
# GPG key already used for signed commits (git config user.signingkey).
# Never hardcode a fingerprint directly in sign-manifest.sh/verify-manifest.sh;
# always read it from here, so the mechanism itself stays operator-agnostic
# (see security/signing.env.example for what ships to the public mirror).
SIGNING_KEY_FINGERPRINT=3B29752DACA3544CEA60D01A7B81F49CD96C1631

# 2026-08-20: separate, no-passphrase key for agent-driven signing (see
# scripts/sign-manifest.sh --agent). Deliberately its own key, not shared
# with the operator's above -- see that flag's comment block for why. Gated
# on a human-issued session_grant or a live ntfy approval round-trip, never
# on secrecy of this key itself.
AGENT_SIGNING_KEY_FINGERPRINT=CC1509BD9278086F113EAF24E10F126919390B37
