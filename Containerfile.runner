# dispatch-runner -- multi-stage build
# Stage 1: Node 20 Alpine -- builds React/Vite frontend
# Base image: the tag is for humans, the digest is the identity (multi-platform
# index: arm64 + amd64). Refresh deliberately with scripts/build/pin-base-images.py.
# SUPERSEDED 2026-10-07: FROM node:20-alpine AS frontend-builder (a tag can move under us; review 05).
FROM docker.io/library/node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS frontend-builder
WORKDIR /build
COPY src/runner/frontend/package*.json ./
# 2026-10-07: npm ci installs EXACTLY the lockfile and fails if package.json and
# the lockfile disagree. SUPERSEDED: `RUN npm install`, which could re-resolve
# versions at build time, so a fixed lockfile (e.g. a Dependabot fix) was not
# guaranteed to be what shipped.
RUN npm ci --no-audit --no-fund
COPY src/runner/frontend/ .
RUN npm run build

# Stage 2: Python 3.13 slim -- FastAPI runtime
# Base image: the tag is for humans, the digest is the identity (multi-platform
# index: arm64 + amd64). Refresh deliberately with scripts/build/pin-base-images.py.
# SUPERSEDED 2026-10-07: FROM python:3.13-slim (a tag can move under us; review 05).
FROM docker.io/library/python:3.13-slim@sha256:27b7c9d4f13ca20bb1170148f02095d50a5dfce1f7f2dabf5ca273727e43b7ea
LABEL org.opencontainers.image.title="corporatetraveldc-runner"
LABEL org.opencontainers.image.description="Corporate Travel DC Dispatch -- runner PWA"
LABEL service="runner"

WORKDIR /app

# 2026-11-03 (Ask rebuild P0, operator option 1): the runner now verifies the signed glossary rules
# block before /api/ask uses it, the same way the poller image does. gnupg is needed at runtime by
# scripts/verify-manifest.sh. Same dated Debian snapshot pattern as Containerfile.poller; refresh with
# scripts/build/pin-base-images.py.
ARG APT_SNAPSHOT=20261030T010607Z
RUN printf 'APT::Snapshot "%s";\n' "${APT_SNAPSHOT}" > /etc/apt/apt.conf.d/50snapshot \
 && apt-get update -qq \
 && apt-get install -y --no-install-recommends gnupg \
 && rm -rf /var/lib/apt/lists/*

COPY src/runner/requirements.txt .
# Python: install ONLY the hash-locked src/runner/requirements.txt (scripts/build/lock-python.py);
# a file whose hash is not in the lock fails the build. pip itself is the
# base image's own (no self-upgrade).
# SUPERSEDED 2026-10-07: pip install -r requirements.txt (>= ranges)
RUN pip install --no-cache-dir --require-hashes --no-deps --only-binary=:all: -r requirements.txt

COPY src/runner/main.py .
COPY src/shared/ ./shared/
# 2026-09-21: runner/main.py's dispatch-chat history moved onto
# common.db.conn() during the SQLite-removal swarm (chat_messages table,
# pg_schema/0056_dispatch_chat.sql) -- this image was never updated to
# actually ship the `common` package it now imports, so it never surfaced
# until runner was rebuilt for the first time since that change:
# `ModuleNotFoundError: No module named 'common'` at container start.
COPY src/common/ ./common/
# 2026-11-03: the verification root. common/llm.py resolves the repo root as parents[2] of
# /app/common/llm.py, i.e. "/", and verify-manifest.sh resolves its own as <script dir>/.., also "/".
# So the verifier, its pinned key and fingerprints, the signed manifest and the one file the runner
# verifies sit at their repo-relative paths under /. Only public material: GPG fingerprints and the
# public key, no private key or passphrase (same as Containerfile.poller).
COPY scripts/verify-manifest.sh /scripts/verify-manifest.sh
COPY security/trusted-signing-key.pub.asc /security/trusted-signing-key.pub.asc
COPY security/signing.env /security/signing.env
COPY MANIFEST.sha256 MANIFEST.sha256.asc /
COPY src/common/glossary_rules.txt /src/common/glossary_rules.txt
COPY --from=frontend-builder /static ./static

ENV PYTHONDONTWRITEBYTECODE=1
ENV STATIC_DIR=/app/static
ENV DISPATCH_BASE_URL=http://127.0.0.1:8000
ENV ULTRAFEEDER_URL=http://127.0.0.1:8080/data/aircraft.json
ENV SSE_INTERVAL_SEC=30

EXPOSE 8001
# 2026-08-25 fix (Opus blind review C-2): --forwarded-allow-ips=* meant
# uvicorn rewrote request.client.host from X-Forwarded-For no matter who
# the TCP peer was -- any caller reaching this container at all, not just
# nginx, could spoof it. PublishPort=127.0.0.1:8001:8001 in the quadlet
# means nginx's own proxied connections are empirically seen by the
# container as coming from 127.0.0.1 (see _is_trusted()'s 2026-08-20
# comment in runner/main.py, verified live for this same pasta network
# setup) -- so pinning to that address means only nginx's own connections
# get X-Forwarded-For honored at all; a direct caller (bypassing nginx,
# e.g. straight to the tailnet-published port) keeps its real, unspoofable
# peer address in request.client.host instead.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001", \
     "--proxy-headers", "--forwarded-allow-ips=127.0.0.1", "--log-level", "info"]
