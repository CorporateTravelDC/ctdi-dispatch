# dispatch-runner -- multi-stage build
# Stage 1: Node 20 Alpine -- builds React/Vite frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /build
COPY src/runner/frontend/package*.json ./
RUN npm install
COPY src/runner/frontend/ .
RUN npm run build

# Stage 2: Python 3.13 slim -- FastAPI runtime
FROM python:3.13-slim
LABEL org.opencontainers.image.title="corporatetraveldc-runner"
LABEL org.opencontainers.image.description="Corporate Travel DC Dispatch -- runner PWA"
LABEL service="runner"

WORKDIR /app
COPY src/runner/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/runner/main.py .
COPY src/shared/ ./shared/
COPY --from=frontend-builder /static ./static

ENV PYTHONDONTWRITEBYTECODE=1
ENV STATIC_DIR=/app/static
ENV DISPATCH_BASE_URL=http://127.0.0.1:8000
ENV ULTRAFEEDER_URL=http://127.0.0.1:8080/data/aircraft.json
ENV SSE_INTERVAL_SEC=30

EXPOSE 8001
# 2026-08-25 fix (Opus blind review C-2): --forwarded-allow-ips=* meant
# uvicorn rewrote request.client.host from X-Forwarded-For no matter who
# the TCP peer was -- any caller reaching this container at all, not just
# nginx, could spoof it. PublishPort=127.0.0.1:8001:8001 in the quadlet
# means nginx's own proxied connections are empirically seen by the
# container as coming from 127.0.0.1 (see _is_trusted()'s 2026-08-20
# comment in runner/main.py, verified live for this same pasta network
# setup) -- so pinning to that address means only nginx's own connections
# get X-Forwarded-For honored at all; a direct caller (bypassing nginx,
# e.g. straight to the tailnet-published port) keeps its real, unspoofable
# peer address in request.client.host instead.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001", \
     "--proxy-headers", "--forwarded-allow-ips=127.0.0.1", "--log-level", "info"]
