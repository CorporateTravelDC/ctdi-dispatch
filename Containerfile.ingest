FROM python:3.13-slim
LABEL org.opencontainers.image.title="corporatetraveldc-ingest" \
      org.opencontainers.image.description="Corporate Travel DC Dispatch — SWIM NMS + NWWS-OI push ingest"

WORKDIR /app

# Install common dependencies first (cached layer).
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# Install ingest-specific dependencies (solace-pubsubplus, etc.).
# Copied before COPY src/ so this layer is cached independently.
COPY src/ingest/requirements.txt ingest-requirements.txt
RUN pip install --no-cache-dir -r ingest-requirements.txt

# Install CA certs needed for TLS to ems2.swim.faa.gov, and gnupg for
# scripts/verify-manifest.sh (signed-manifest integrity check, see
# docs/COMPLIANCE_SECURITY.md "Signed Manifest Integrity").
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends ca-certificates gnupg \
 && rm -rf /var/lib/apt/lists/*

# src/ kept at src/ (not flattened to .) so the container's internal layout
# matches the repo's own relative paths 1:1 -- the signed manifest's entries
# resolve correctly against this image without path-translation logic.
COPY src/ src/
COPY scripts/verify-manifest.sh scripts/verify-manifest.sh
COPY scripts/verified-exec.sh scripts/verified-exec.sh
COPY security/trusted-signing-key.pub.asc security/trusted-signing-key.pub.asc
COPY MANIFEST.sha256 MANIFEST.sha256.asc ./
# 2026-08-10: see Containerfile.poller's identical comment -- Modelfiles
# need to be present for common/llm.py's pre-inference integrity check to
# ever succeed inside a container. Whole-glob copy, not per-model.
COPY corporatetraveldc.* ./
RUN chmod +x scripts/verify-manifest.sh scripts/verified-exec.sh

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
CMD ["python3", "-m", "ingest.main"]
