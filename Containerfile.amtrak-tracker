# Base image: the tag is for humans, the digest is the identity (multi-platform
# index: arm64 + amd64). Refresh deliberately with scripts/build/pin-base-images.py.
# SUPERSEDED 2026-10-07: FROM python:3.13-slim (a tag can move under us; review 05).
FROM docker.io/library/python:3.13-slim@sha256:bf44cdfcb76cd3b41e879bc058fc37ec5872002ccfde7fcb765e218cde0cd79c

LABEL org.opencontainers.image.title="corporatetraveldc-amtrak-tracker" \
      org.opencontainers.image.description="Corporate Travel DC — Amtrak NEC push-primary tracker"

WORKDIR /app

# 2026-09-01: box runs a permanently-busy shared LLM chat tier (150%+ CPU
# sustained) alongside 30+ containers -- pip's 15s default read-timeout is
# too tight under that contention and kills slow-but-alive downloads,
# surfacing as "Connection interrupted"/ResolutionImpossible mid-build.
ENV PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=10

COPY requirements.txt .
# Python: install ONLY the hash-locked requirements.txt (scripts/build/lock-python.py);
# a file whose hash is not in the lock fails the build. pip itself is the
# base image's own (no self-upgrade).
# SUPERSEDED 2026-10-07: pip install --upgrade pip && pip install -r requirements.txt (>= ranges)
RUN pip install --no-cache-dir --require-hashes --no-deps --only-binary=:all: -r requirements.txt

# gnupg: needed at runtime by scripts/verify-manifest.sh (signed-manifest
# integrity check, see docs/COMPLIANCE_SECURITY.md "Signed Manifest Integrity").
# OS packages from a dated Debian archive snapshot, not the live mirror:
# the same APT_SNAPSHOT always yields the same package versions. Refresh it
# deliberately with scripts/build/pin-base-images.py (security updates).
# SUPERSEDED 2026-10-07: apt-get update against the live mirror (floating).
ARG APT_SNAPSHOT=20261007T000000Z
RUN printf 'APT::Snapshot "%s";\n' "${APT_SNAPSHOT}" > /etc/apt/apt.conf.d/50snapshot \
 && apt-get update -qq \
 && apt-get install -y --no-install-recommends gnupg \
 && rm -rf /var/lib/apt/lists/*

# src/ kept at src/ (not flattened to .) so the container's internal layout
# matches the repo's own relative paths 1:1 -- the signed manifest's entries
# resolve correctly against this image without path-translation logic.
COPY src/ src/
COPY scripts/verify-manifest.sh scripts/verify-manifest.sh
COPY scripts/verified-exec.sh scripts/verified-exec.sh
COPY security/trusted-signing-key.pub.asc security/trusted-signing-key.pub.asc
# 2026-08-25 fix (Opus blind review C-4 follow-up): verify-manifest.sh
# now requires signing.env (SIGNING_KEY_FINGERPRINT/AGENT_SIGNING_KEY_
# FINGERPRINT) to pin the signing key -- it was never copied into any
# image before, so every verify-manifest.sh/verified-exec.sh call
# inside a container started failing closed the moment that fix
# shipped (confirmed live: corporatetraveldc-demo-api's verified-exec-
# wrapped startup crash-looped on "missing security/signing.env").
# Contains only GPG fingerprints, no private-key/passphrase material --
# safe to bake in the same as the pubkey above.
COPY security/signing.env security/signing.env
COPY MANIFEST.sha256 MANIFEST.sha256.asc ./
# 2026-08-10: see Containerfile.poller's identical comment -- Modelfiles
# need to be present for common/llm.py's pre-inference integrity check to
# ever succeed inside a container. Whole-glob copy, not per-model.
COPY corporatetraveldc.* ./
RUN chmod +x scripts/verify-manifest.sh scripts/verified-exec.sh

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

CMD ["python3", "-m", "amtrak_tracker.main"]
