{
  "schema_version": "1.0",
  "deployment": {
    "id": "example-executive-assistant",
    "display_name": "Executive Assistant Reference",
    "profile": "executive-assistant",
    "environment": "staging",
    "timezone": "UTC",
    "locale": "en-US",
    "jurisdiction": "CHANGE_ME",
    "data_residency": "local",
    "offline_mode": "degraded",
    "retention_days": 90
  },
  "organization": {
    "legal_name": "CHANGE_ME",
    "industry": "executive_operations",
    "operator_roles": [
      "owner"
    ],
    "regulated": true,
    "compliance_frameworks": []
  },
  "geography": {
    "country_codes": [],
    "regions": [],
    "service_areas": [],
    "home_base": {
      "latitude": null,
      "longitude": null,
      "radius_km": null
    },
    "airports": [],
    "rail_stations": [],
    "weather": {
      "provider": "none",
      "nws_areas": [],
      "nws_wfos": []
    },
    "airspace": {
      "static_layers": [],
      "tfr_enabled": false
    },
    "distance_unit": "km",
    "currency": "USD"
  },
  "sources": {
    "enabled": [
      "calendar",
      "contacts",
      "email",
      "document_repository"
    ],
    "disabled": [],
    "credentials_ref": {},
    "source_regions": {}
  },
  "modules": {
    "enabled": [
      "dashboard",
      "tasks",
      "notifications",
      "audit",
      "local_knowledge",
      "calendar_coordination",
      "meeting_preparation",
      "travel_coordination",
      "follow_up",
      "document_intake"
    ],
    "disabled": []
  },
  "workflows": {
    "objects": [
      "principal",
      "meeting",
      "trip",
      "travel_document",
      "contact",
      "action_item"
    ],
    "state_machine": [
      "intake",
      "triaged",
      "scheduled",
      "booked",
      "prepared",
      "completed",
      "archived"
    ],
    "triggers": [],
    "approvals": [
      "send_on_behalf_of_principal",
      "book_travel",
      "share_itinerary"
    ],
    "notifications": {
      "channels": [
        "in_app"
      ],
      "quiet_hours": {
        "start": "22:00",
        "end": "07:00"
      },
      "materiality_rules": []
    }
  },
  "security": {
    "network_exposure": "private_overlay",
    "default_deny": true,
    "human_signed_actions": [
      "publish",
      "deploy",
      "export_sensitive",
      "change_permissions"
    ],
    "agent_scopes": {},
    "secrets_backend": "host_protected",
    "pii_classes": [
      "calendar",
      "contacts",
      "travel_itinerary",
      "travel_documents"
    ],
    "audit": {
      "hash_chain": true,
      "independent_checkpoint": "required_for_high_assurance"
    },
    "backup": {
      "encrypted": true,
      "restore_test_required": true
    }
  },
  "build": {
    "target_platforms": [
      "host"
    ],
    "signed_source_required": true,
    "receipt_required": true,
    "sbom_required": true,
    "runtime_image_identity_check": true
  },
  "integrations": {
    "optional": [
      {
        "id": "nextcloud-calendar",
        "kind": "nextcloud_app",
        "app": "calendar",
        "state": "installed_disabled"
      },
      {
        "id": "nextcloud-contacts",
        "kind": "nextcloud_app",
        "app": "contacts",
        "state": "installed_disabled"
      },
      {
        "id": "nextcloud-tasks",
        "kind": "nextcloud_app",
        "app": "tasks",
        "state": "installed_disabled"
      },
      {
        "id": "paperless-ngx",
        "kind": "container",
        "unit": "corporatetraveldc-paperless",
        "state": "disabled",
        "shared_with": [
          "cfo"
        ],
        "note": "itineraries, e-tickets, receipts"
      },
      {
        "id": "pgsql-office",
        "kind": "database_instance",
        "unit": "corporatetraveldc-pgsql-office",
        "state": "disabled",
        "note": "office skeletons instance; one database and role per service"
      }
    ],
    "forbidden": [
      "sqlite_backend",
      "platform_env_files",
      "production_database"
    ]
  },
  "deployment_gate": {
    "requires_operator_review": true,
    "requires_schema_validation": true,
    "requires_source_entitlements": true,
    "requires_test_replay": true,
    "requires_privacy_review": true
  }
}
