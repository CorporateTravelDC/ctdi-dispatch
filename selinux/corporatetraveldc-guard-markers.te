module corporatetraveldc-guard-markers 1.0;

# 2026-11-18 (operator): the failover polkit rule (config/polkit/49-ctdc-net-failover.rules) decides from
# four marker paths. polkitd runs as policykit_t, which may not getattr var_run_t / var_lib_t files, so on
# this enforcing box the rule could not see them (AVC: denied { getattr } for comm="sh"
# path="/run/ctdc-boot-guard/verified" scontext=policykit_t tcontext=var_run_t). Result: `verified` read
# as absent (failover refused), and a real lockdown marker would have read as absent too (fail open).
#
# One private type for exactly these markers, readable (stat only) by policykit_t:
#   /run/ctdc-boot-guard(/.*)?                 verified
#   /run/corporatetraveldc-lockdown-active     volatile lockdown marker
#   /var/lib/ctdc-lockdown(/.*)?               lockdown-active, uncommanded-reboot-hold, reboot-commanded
# Named type transitions label them at creation by the domains that create them: unconfined_t (sudo:
# lockdown.sh, restore-network.sh, ctdc-reboot.sh, relays), unconfined_service_t (the boot-guard units),
# fail2ban_t (lockdown.sh / restore-network.sh as fail2ban's ban/unban action). Files created inside a
# ctdc_guard_state_t directory inherit the type. The same paths carry `semanage fcontext` entries so
# restorecon keeps the label (selinux/apply-selinux-policy.sh, and the relay that installs this module).
#
# Grants, narrowest that resolves it (docs/COMPLIANCE_SECURITY.md, "SELinux Grant Policy"):
#   policykit_t: getattr on the marker files, getattr/search on their directories -- no read, no write.
#   fail2ban_t: create/remove the markers the way lockdown.sh / restore-network.sh do (install -d, write
#               .new, chmod, mv, rm). It already writes /run files as fail2ban_var_run_t; without this its
#               lockdown marker would be denied once the named transition applies -- a silent fail open.
#               (Creating /var/lib/ctdc-lockdown itself from fail2ban_t is NOT granted: the directory is
#               made once, as root, by the relay that installs this module.)
# unconfined_t / unconfined_service_t need no allow: they hold files_unconfined_type over file_type.

require {
	type policykit_t;
	type unconfined_t;
	type unconfined_service_t;
	type fail2ban_t;
	type var_run_t;
	type var_lib_t;
	attribute file_type;
	attribute non_security_file_type;
	attribute non_auth_file_type;
	class dir { getattr search open read write add_name remove_name create setattr };
	class file { getattr open read write create append unlink setattr rename };
}

type ctdc_guard_state_t;
typeattribute ctdc_guard_state_t file_type, non_security_file_type, non_auth_file_type;

#============= label at creation ==============
type_transition unconfined_t var_run_t:dir ctdc_guard_state_t "ctdc-boot-guard";
type_transition unconfined_service_t var_run_t:dir ctdc_guard_state_t "ctdc-boot-guard";
type_transition fail2ban_t var_run_t:dir ctdc_guard_state_t "ctdc-boot-guard";
type_transition unconfined_t var_run_t:file ctdc_guard_state_t "corporatetraveldc-lockdown-active";
type_transition unconfined_service_t var_run_t:file ctdc_guard_state_t "corporatetraveldc-lockdown-active";
type_transition fail2ban_t var_run_t:file ctdc_guard_state_t "corporatetraveldc-lockdown-active";
type_transition unconfined_t var_lib_t:dir ctdc_guard_state_t "ctdc-lockdown";
type_transition unconfined_service_t var_lib_t:dir ctdc_guard_state_t "ctdc-lockdown";

#============= policykit_t: see the markers, nothing more ==============
allow policykit_t ctdc_guard_state_t:dir { getattr search };
allow policykit_t ctdc_guard_state_t:file getattr;

#============= fail2ban_t: lockdown.sh / restore-network.sh as fail2ban actions ==============
allow fail2ban_t ctdc_guard_state_t:dir { getattr search open read write add_name remove_name create setattr };
allow fail2ban_t ctdc_guard_state_t:file { getattr open read write create append unlink setattr rename };
