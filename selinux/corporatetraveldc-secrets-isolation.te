module corporatetraveldc-secrets-isolation 1.0;

# =============================================================================
# Per-consumer isolation of ~/.secrets
#
# Operator directive 2026-09-24: "confine every goddamn thing and make that
# entire directory accessible by everything that respectively needs it with its
# specific token files only."
#
# WHY THIS EXISTS
# ~/.secrets holds 26 credentials, every one labelled user_home_t. That label
# is not an access decision -- it is the absence of one. Anything that can read
# ONE file there can read ALL 26, and the only thing preventing that today is
# that almost every consumer runs unconfined_service_t, where SELinux is not
# making decisions at all.
#
# fail2ban is the single exception: it runs CONFINED as fail2ban_t, which is
# why it alone could not read its own token and why the gap was found at all.
# That is the correct state generalised the wrong way round -- the fix is not
# to move fail2ban's credential somewhere less protected, it is to give every
# credential a type and every consumer access to exactly one.
#
# THE MODEL
# One type per credential (or per credential group sharing a single consumer).
# The directory gets its own searchable type. A confined domain is granted read
# on precisely the type it owns -- never on the directory's contents wholesale.
# Adding a consumer means adding a type and one allow rule, so the blast radius
# of any future confined service is one file by construction.
#
# STATUS: first slice. fail2ban only, because it is the only confined host
# consumer today. The remaining 25 credentials keep user_home_t until their
# consumers are themselves confined -- labelling them now would buy nothing
# and would break unconfined readers for no gain. See the staged plan in the
# docs/SECRETS_NAMING_AND_ISOLATION.md -- naming convention, full credential
# registry, and the per-consumer isolation rule this module implements.
# =============================================================================

# NOTE on form: this is a raw .te built with `checkmodule -M -m`, so refpolicy
# interfaces (files_type(), etc.) are NOT available -- they live in the
# selinux-policy-devel headers. New types therefore declare their attributes
# inline, which is equivalent for our purposes: file_type makes it a valid
# file label, non_security_file_type keeps it out of the security_file_type
# set so it is not treated as policy/security data.
require {
	type fail2ban_t;
	type user_home_dir_t;
	attribute file_type;
	attribute non_security_file_type;
	class dir { search getattr open read };
	class file { getattr open read ioctl lock map };
}

# --- The secrets directory itself ------------------------------------------
# Own type so a confined domain can traverse INTO ~/.secrets without being
# granted search over user_home_t generally. Deliberately not readable as a
# dir by fail2ban: it may traverse to a named file, it may not enumerate what
# else is in there. Directory listing is itself a disclosure -- knowing that
# `github_pat.token` exists is information fail2ban has no need for.
type ctdc_secrets_dir_t, file_type, non_security_file_type;

# --- fail2ban's Cloudflare honeypot token -----------------------------------
# Read by scripts/cf-honeypot-ban.sh, invoked from
# /etc/fail2ban/action.d/cloudflare-token-corporatetraveldc.conf.
# Zone-scoped (firewall access rules on one zone) -- verified 2026-09-24 to be
# a DIFFERENT credential from cf_management_api.token, which is account-scoped.
# Keep it that way: this type exists so a leak here costs one zone's firewall
# rules and nothing else.
type ctdc_secret_cf_honeypot_t, file_type, non_security_file_type;

# Traverse into the directory, and read exactly one file in it.
allow fail2ban_t ctdc_secrets_dir_t:dir search;
allow fail2ban_t ctdc_secret_cf_honeypot_t:file { getattr open read ioctl };

# Path from / to the file. user_home_dir_t:dir search is already granted by
# corporatetraveldc-fail2ban-lockdown.te; restated in require above so this
# module is readable standalone, not re-granted here.
