module corporatetraveldc-fail2ban-cf-egress 1.0;

# fail2ban's cloudflare-token-corporatetraveldc action
# (fail2ban/action.d/cloudflare-token-corporatetraveldc.conf, invoked from
# jail.d/nginx-honeypot-corporatetraveldc.conf) calls
# scripts/cf-honeypot-ban.sh, which curl's the Cloudflare Firewall Access
# Rules API to add/remove an IP Access Rule per honeypot ban/unban. Without
# this grant, every such call from fail2ban_t failed with curl reporting
# `http=000` (a connection-level failure, never even reaching the network) --
# invisible unless the calling script explicitly checks the HTTP status
# itself (plain `curl -s` swallows this identically to an HTTP error; see
# docs/HONEYPOT_FAIL2BAN.md's postmortem section for the full debugging
# story). Confirmed live 2026-08-09 via a real honeypot-triggered ban:
#
#   avc: denied { name_connect } for comm="curl" dest=443
#        scontext=system_u:system_r:fail2ban_t:s0
#        tcontext=system_u:object_r:pihole_port_t:s0 tclass=tcp_socket
#
# Port 443 on this box is SELinux-labeled pihole_port_t rather than the
# stock http_port_t (a side effect of prior Pi-hole SELinux customization,
# not something introduced here) -- fail2ban_t has no rule permitting
# name_connect to that type, so ANY outbound HTTPS call from a fail2ban
# action fails identically, regardless of destination. This grant is scoped
# to exactly that one gap.
#
# audit2allow's first pass over this same denial set also proposed
# `allow fail2ban_t self:process execmem` (grep -oP's PCRE JIT compiler
# needs it) -- deliberately NOT included here. scripts/cf-honeypot-notes.sh
# was rewritten to extract the same fields with `sed` (POSIX BRE, never
# JIT-compiles) instead of `grep -oP`, so the permission is avoidable
# entirely rather than granted and left as a standing exception. Neither
# lockdown.sh nor restore-network.sh use grep -P either, so no other
# fail2ban_t script needs it.
#
# Scoped to exactly this one grant for fail2ban_t -- not a broader domain
# transition, not a port relabel (which could have side effects on whatever
# legitimately uses pihole_port_t), matching the same
# narrowest-scope-that-resolves-it principle as every other module in this
# repo (see COMPLIANCE_SECURITY.md's "SELinux Grant Policy").

require {
	type fail2ban_t;
	type pihole_port_t;
	class tcp_socket name_connect;
}

#============= fail2ban_t ==============
allow fail2ban_t pihole_port_t:tcp_socket name_connect;
